+def _invocation_consumer_capabilities(enabled_tools, enabled_toolsets, disabled_toolsets):
+    """Immutable model-visible/direct and scoped-deferred tools for this invocation.
 
+    ``enabled_tools`` is a copied snapshot of ``agent.valid_tool_names``. Never infer an
+    unrestricted surface when it is absent: direct calls outside an agent run have no
+    model-visible consumer proof and must fail closed in transform hooks.
+    """
+    if enabled_tools is None:
+        return None
+    direct = frozenset(
+        name.strip().lower() for name in enabled_tools
+        if isinstance(name, str) and name.strip()
+    )
+    deferred = frozenset()
+    bridges = {"tool_search", "tool_describe", "tool_call"}
+    if bridges <= direct:
+        try:
+            from tools.tool_search import scoped_deferrable_names
+            raw_defs = get_tool_definitions(
+                enabled_toolsets=enabled_toolsets,
+                disabled_toolsets=disabled_toolsets,
+                quiet_mode=True,
+                skip_tool_search_assembly=True,
+            )
+            deferred = scoped_deferrable_names(raw_defs)
+        except Exception:
+            # Missing deferred proof must narrow capability, never widen it.
+            deferred = frozenset()
+    return MappingProxyType({
+        "direct_tools": tuple(sorted(direct)),
+        "deferred_tools": tuple(sorted(deferred)),
+    })
