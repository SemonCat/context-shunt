# --- context-shunt private/runtime artifacts (never packaged, never committed) ---
# Spill cache, snapshots and any materialized source payload
.shunt-cache/
*.shunt-spill
snapshots/
spill/

# Verification reports (may contain host paths / timings)
reports/
.reports/

# Secrets and local host config
.env
.env.*
*.pem
*.key
auth.json
local.config.json
examples/config/*.local.*

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/
build/
dist/

# Node / TypeScript
node_modules/
packages/core-ts/dist/
adapters/openclaw/dist/
*.tsbuildinfo
.vitest/

# OS
.DS_Store
