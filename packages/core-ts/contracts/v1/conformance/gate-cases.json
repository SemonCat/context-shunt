{
  "schema_version": "1.0",
  "description": "Pre-read gate contract. Outcomes are tri-state: passthrough (not read-like; host policy owns it), allow (read-like AND provably bounded/small), blocked (LARGE_READ or UNCLASSIFIABLE_READ). Every blocked case MUST result in zero underlying tool invocations. The probe table stands in for the filesystem so both cores decide identically.",
  "probe_table": {
    "/ws/small349.txt": {
      "lines": 349,
      "bytes": 4000
    },
    "/ws/edge350.txt": {
      "lines": 350,
      "bytes": 4000
    },
    "/ws/big351.txt": {
      "lines": 351,
      "bytes": 4200
    },
    "/ws/huge.txt": {
      "lines": 90000,
      "bytes": 3000000
    },
    "/ws/longline.txt": {
      "lines": 1,
      "bytes": 20000
    },
    "/ws/empty.txt": {
      "lines": 0,
      "bytes": 0
    },
    "/ws/a.txt": {
      "lines": 100,
      "bytes": 1200
    },
    "/ws/b.txt": {
      "lines": 100,
      "bytes": 1200
    },
    "/ws/c.txt": {
      "lines": 200,
      "bytes": 2400
    },
    "/ws/missing.txt": {
      "missing": true
    },
    "/ws/data": {
      "kind": "directory"
    },
    "/ws/pipe.fifo": {
      "kind": "fifo"
    }
  },
  "cases": [
    {
      "id": "read_349_full_allow",
      "input": {
        "tool": "read",
        "args": {
          "file_path": "/ws/small349.txt"
        }
      },
      "expect": {
        "decision": "allow",
        "form": "full_read"
      }
    },
    {
      "id": "read_350_full_allow",
