  "marker_cases": {
    "description": "The publication invariant. `text` is a fully rendered answer and `published` is the set of citation ids the same envelope publishes; `expect.unpublished` is every marker id in the answer that no published citation backs, sorted and deduplicated. An empty list is the only publishable state - the reader refuses the envelope otherwise, because the alternative is an answer citing evidence it does not carry.",
    "cases": [
      {
        "id": "every_marker_is_published",
        "text": "Retries stop after three attempts [c1]. Backoff is exponential [c2].",
        "published": [
          "c1",
          "c2"
        ],
        "expect": {
          "unpublished": []
        }
      },
      {
        "id": "forged_marker_is_reported",
        "text": "Retries stop after three attempts [c999].",
        "published": [
          "c1"
        ],
        "expect": {
          "unpublished": [
            "c999"
          ]
        }
      },
      {
        "id": "several_forged_markers_are_deduplicated_and_sorted",
        "text": "One [c9]. Two [c8]. Three [c9].",
        "published": [
          "c1"
        ],
        "expect": {
          "unpublished": [
            "c8",
            "c9"
          ]
        }
      },
      {
        "id": "a_dropped_citation_leaves_its_marker_unpublished",
        "comment": "What an envelope-fit or cap drop looks like from here: the citation is gone from `published` while the marker is still in the text.",
        "text": "Retries stop after three attempts [c1]. Backoff is exponential [c2].",
        "published": [
          "c1"
        ],
        "expect": {
          "unpublished": [
            "c2"
          ]
        }
      },
      {
        "id": "the_unmappable_marker_is_never_published",
        "comment": "`[c0]` is what a legacy marker naming an id its own chunk never declared is rewritten to. Global ids start at c1, so it can never match a published citation and the sentence carrying it is always dropped.",
        "text": "Cross-chunk evidence [c0].",
        "published": [
          "c1",
          "c2"
        ],
        "expect": {
          "unpublished": [
            "c0"
          ]
        }
      },
      {
        "id": "an_answer_with_no_markers_publishes_nothing_unbacked",
        "text": "The excerpt does not answer the question.",
        "published": [],
        "expect": {
          "unpublished": []
        }
      }
    ]
