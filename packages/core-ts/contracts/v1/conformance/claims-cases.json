{
  "schema_version": "1.1",
  "description": "Structured claims contract: normalize_claims/normalizeClaims validates a model's claims array structurally against its own citations array before verification; render_claims/renderClaims deterministically places every [cN] marker from the surviving claims. Both language cores must agree on every case here. citations_seen is the set of local ids the same response declared in its citations array (before namespacing) - what normalize_claims checks citation_ids against. Revision 1.1 adds the forged-marker rule: marker syntax in a model-authored claim text drops that claim, and marker_cases fixes the publication invariant unpublished_marker_ids/unpublishedMarkerIds enforces on the way out - every [cN] in a published answer must name a citation the same envelope publishes.",
  "cases": [
    {
      "id": "single_claim_single_citation",
      "citations_seen": [
        "c1",
        "c2"
      ],
      "claims": [
        {
          "text": "Retries stop after three attempts.",
          "citation_ids": [
            "c1"
          ]
        }
      ],
      "expect": {
        "surviving_claims": [
          {
            "text": "Retries stop after three attempts.",
            "citation_ids": [
              "c1"
            ]
          }
        ],
        "rendered": "Retries stop after three attempts [c1]."
      }
    },
    {
