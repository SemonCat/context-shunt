{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/context-shunt/contracts/v1/request.schema.json",
  "title": "context-shunt v1 core request",
  "description": "Revision 1.3. A 1.0 read request remains valid unchanged; inspect and stats require schema_version 1.1 or newer. Revision 1.2 raises only the whole-reader deadline ceiling from 60 to 240 seconds. Revision 1.3 adds the read selector's optional `patterns` field (literal OR across exact substrings) and the inspect `aggregate` selector for bounded exact structured results. The unchanged single-literal `pattern` field never assigns special meaning to `|`. Sources are always opaque session-scoped handles - a filesystem path never enters this contract.",
  "type": "object",
  "required": ["schema_version", "request_id", "operation"],
  "oneOf": [
    { "$ref": "#/$defs/readRequest" },
    { "$ref": "#/$defs/inspectRequest" },
    { "$ref": "#/$defs/statsRequest" }
  ],
  "$defs": {
    "schemaVersion": { "enum": ["1.0", "1.1", "1.2", "1.3"] },
    "requestId": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "operation", "question", "sources", "budgets"],
      "properties": {
        "schema_version": { "$ref": "#/$defs/schemaVersion" },
        "request_id": { "$ref": "#/$defs/requestId" },
        "operation": {
          "description": "v1 accepts read, inspect and stats. propose_patch is reserved for a future schema version and MUST be rejected here.",
          "const": "read"
        },
        "question": { "type": "string", "minLength": 1, "maxLength": 2048, "pattern": "\\S" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/requestSource" }
        },
        "budgets": { "$ref": "#/$defs/budgets" },
        "refined": {
          "description": "1.1: true when this question re-uses handles the caller already holds. A refined question MUST reuse the same immutable snapshot and MUST NOT recapture the source. Absent means false.",
          "type": "boolean"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
          "then": { "not": { "required": ["refined"] } }
        },
        {
          "if": { "properties": { "schema_version": { "enum": ["1.0", "1.1"] } }, "required": ["schema_version"] },
          "then": {
            "properties": {
              "budgets": {
                "properties": {
                  "deadline_ms": { "maximum": 60000 }
                }
              }
            }
          }
        },
        {
          "if": { "properties": { "schema_version": { "enum": ["1.0", "1.1", "1.2"] } }, "required": ["schema_version"] },
          "then": {
            "properties": {
              "sources": {
                "items": {
                  "properties": {
                    "selector": { "not": { "required": ["patterns"] } }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "inspectRequest": {
      "description": "1.1: zero-model deterministic extraction by handle and snapshot identity.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "operation", "source_id", "snapshot_id", "selector", "budgets"],
      "properties": {
        "schema_version": { "enum": ["1.1", "1.2", "1.3"] },
        "request_id": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "inspect" },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "selector": { "$ref": "#/$defs/inspectSelector" },
        "budgets": { "$ref": "#/$defs/inspectBudgets" },
        "cursor": {
          "description": "Opaque authenticated continuation cursor from a previous inspect result. Bound to handle, snapshot and selector; a tampered or foreign cursor is refused.",
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^csr_[A-Za-z0-9_-]{8,504}$"
        }
      },
      "allOf": [{
        "if": { "properties": { "schema_version": { "enum": ["1.1", "1.2"] } }, "required": ["schema_version"] },
        "then": { "properties": { "selector": { "not": { "properties": { "kind": { "const": "aggregate" } }, "required": ["kind"] } } } }
      }]
    },
    "statsRequest": {
      "description": "1.1: read-only session aggregate plus a bounded page of operation records. Cannot reset metrics, change retention, or address another session.",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "request_id", "operation"],
      "properties": {
        "schema_version": { "enum": ["1.1", "1.2", "1.3"] },
        "request_id": { "$ref": "#/$defs/requestId" },
        "operation": { "const": "stats" },
        "page": { "type": "integer", "minimum": 1, "maximum": 64 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 8 }
      }
    },
    "requestSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "snapshot_id", "selector"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "selector": { "$ref": "#/$defs/selector" }
      }
    },
    "sourceId": {
      "description": "Opaque session-scoped capability handle issued by the store. Never a filesystem path.",
      "type": "string",
      "minLength": 4,
      "maxLength": 64,
      "pattern": "^src_[A-Za-z0-9]{4,58}$"
    },
    "snapshotId": {
      "description": "Full SHA-256 of the immutable snapshot bytes.",
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "selector": {
      "description": "Mutually exclusive tagged union. lines/records ordinals are 1-based inclusive.",
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "all" } }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "lines" },
            "start": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "end": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "pointer", "start", "end"],
          "properties": {
            "kind": { "const": "records" },
            "pointer": { "type": "string", "maxLength": 1024, "pattern": "^(/([^/~]|~[01])*)*$" },
            "start": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "end": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          }
        },
        {
          "description": "Literal-only search. `pattern` is a single literal substring, unchanged since 1.0: it is never parsed for `|`, regex metacharacters, or any other OR syntax, so an existing pattern that happens to contain those characters keeps its exact prior meaning forever. `patterns` (1.3+) is the explicit, additive way to ask for an OR across several literal substrings - a line matches if it contains any one of them. Exactly one of the two is present.",
          "required": ["kind", "max_matches"],
          "oneOf": [
            {
              "additionalProperties": false,
              "required": ["pattern"],
              "properties": {
                "kind": { "const": "search" },
                "pattern": { "type": "string", "minLength": 1, "maxLength": 512 },
                "max_matches": { "type": "integer", "minimum": 1, "maximum": 200 }
              }
            },
            {
              "additionalProperties": false,
              "required": ["patterns"],
              "properties": {
                "kind": { "const": "search" },
                "patterns": {
                  "description": "1.3: one or more literal substrings, OR-combined. Each is matched literally, exactly like `pattern` - never a regular expression.",
                  "type": "array",
                  "minItems": 1,
                  "maxItems": 16,
                  "items": { "type": "string", "minLength": 1, "maxLength": 512 }
                },
                "max_matches": { "type": "integer", "minimum": 1, "maximum": 200 }
              }
            }
          ]
        }
      ]
    },
    "inspectSelector": {
      "description": "Strict union. lines: 1-based inclusive ordinals. bytes: 0-based half-open offsets. search: literal needle only, never a regular expression.",
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        {
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "lines" },
            "start": { "type": "integer", "minimum": 1, "maximum": 100000000 },
            "end": { "type": "integer", "minimum": 1, "maximum": 100000000 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "start", "end"],
          "properties": {
            "kind": { "const": "bytes" },
            "start": { "type": "integer", "minimum": 0, "maximum": 8388608 },
            "end": { "type": "integer", "minimum": 0, "maximum": 8388608 }
          }
        },
        {
          "additionalProperties": false,
          "required": ["kind", "needle", "max_matches"],
          "properties": {
            "kind": { "const": "search" },
            "needle": { "type": "string", "minLength": 1, "maxLength": 512 },
            "max_matches": { "type": "integer", "minimum": 1, "maximum": 200 },
            "context_lines": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        {
          "description": "1.3: bounded deterministic count/distinct/grouping over an array in a validated JSON snapshot. Optional expansion and embedded-JSON parsing cover Loki's minified result/values shape without regular expressions or unbounded parsing.",
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "records_pointer"],
          "properties": {
            "kind": { "const": "aggregate" },
            "records_pointer": { "$ref": "#/$defs/jsonPointer" },
            "expand_pointer": { "$ref": "#/$defs/jsonPointer" },
            "record_pointer": { "$ref": "#/$defs/jsonPointer" },
            "parse_json": { "type": "boolean" },
            "filter": {
              "type": "object",
              "additionalProperties": false,
              "required": ["pointer"],
              "properties": {
                "pointer": { "$ref": "#/$defs/jsonPointer" },
                "equals": { "$ref": "#/$defs/scalar" },
                "contains": { "type": "string", "minLength": 1, "maxLength": 512 }
              },
              "oneOf": [{ "required": ["equals"] }, { "required": ["contains"] }]
            },
            "group_by": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/jsonPointer" } },
            "distinct": { "type": "array", "maxItems": 4, "uniqueItems": true, "items": { "$ref": "#/$defs/jsonPointer" } }
          }
        }
      ]
    },
    "jsonPointer": { "type": "string", "maxLength": 1024, "pattern": "^(/([^/~]|~[01])*)*$" },
    "scalar": {
      "description": "An aggregate comparison scalar. Numbers are restricted to the cross-runtime exact integer range; use strings for larger numeric identifiers or decimal values.",
      "oneOf": [
        { "type": "string", "maxLength": 512 },
        { "type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991 },
        { "type": "boolean" },
        { "type": "null" }
      ]
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_chunks", "max_answer_bytes", "deadline_ms"],
      "properties": {
        "max_chunks": { "type": "integer", "minimum": 1, "maximum": 8 },
        "max_answer_bytes": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 240000 }
      }
    },
    "inspectBudgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_result_bytes", "max_scan_lines"],
      "properties": {
        "max_result_bytes": { "type": "integer", "minimum": 1, "maximum": 16384 },
        "max_scan_lines": { "type": "integer", "minimum": 1, "maximum": 20000 }
      }
    }
  }
}
