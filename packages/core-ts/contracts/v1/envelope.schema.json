{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/context-shunt/contracts/v1/envelope.schema.json",
  "title": "context-shunt v1 bounded envelope",
  "description": "The single reply shape for every gate, reader, inspect, stats, spill and failure path. Revision 1.1 adds result_kind, provenance, accounting_id and the extraction/stats/recovery/import_receipt blocks; a 1.0 envelope remains valid unchanged. No raw/debug field may be added, and no field may carry a filesystem path, a question, a payload preview or a provider error body.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_id", "status", "code", "answer", "citations", "coverage", "sources", "retryable"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1"] },
    "request_id": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9_.:-]+$" },
    "status": { "enum": ["ok", "partial", "blocked", "error"] },
    "code": {
      "enum": ["ANSWERED", "NO_MATCH", "LARGE_READ", "UNCLASSIFIABLE_READ", "SPILLED",
        "EXTRACTED", "STATS", "IMPORTED", "LEGACY_COMPACTED", "INVALID_REQUEST", "UNSUPPORTED_VERSION", "UNSAFE_SOURCE",
        "SOURCE_CHANGED", "SOURCE_EXPIRED", "BINARY_UNSUPPORTED", "LIMIT_EXCEEDED", "TIMEOUT",
        "MODEL_ERROR", "INVALID_MODEL_OUTPUT", "CITATION_INVALID", "SPILL_FAILED",
        "STORE_FAILED", "DISCLOSURE_EXHAUSTED", "PROVENANCE_UNAVAILABLE",
        "HOST_UNSAFE", "UPSTREAM_TRUNCATED", "CANCELLED"]
    },
    "answer": { "type": "string", "maxLength": 8192 },
    "citations": { "type": "array", "maxItems": 16, "items": { "$ref": "#/$defs/citation" } },
    "coverage": { "$ref": "#/$defs/coverage" },
    "sources": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/sourceHandle" } },
    "retryable": { "type": "boolean" },
    "guidance": {
      "description": "Optional bounded operator/agent guidance. Never contains source content.",
      "type": "string",
      "maxLength": 2048
    },
    "pointer": { "$ref": "#/$defs/spillPointer" },
    "result_kind": {
      "description": "1.1: what this envelope is. model_derived text is generated by the reader model and is never raw source; deterministic_extraction is exact bytes taken from the immutable snapshot with no model involved; legacy_compaction is a deterministic heuristic summary (never exact bytes, never model-derived) produced only after a reader failure.",
      "enum": ["model_derived", "deterministic_extraction", "legacy_compaction", "gate_decision", "pointer", "stats", "failure"]
    },
    "provenance": { "$ref": "#/$defs/provenance" },
    "accounting_id": {
      "description": "1.1: opaque id of the accounting record for this operation. The record itself lives in the store and is read back through the stats operation, so the envelope never has to measure itself.",
      "type": "string",
      "pattern": "^acc_[0-9a-f]{16}$"
    },
    "import_receipt": { "$ref": "#/$defs/importReceipt" },
    "extraction": { "$ref": "#/$defs/extraction" },
    "legacy_compaction": { "$ref": "#/$defs/legacyCompaction" },
    "stats": { "$ref": "#/$defs/stats" },
    "recovery": { "$ref": "#/$defs/recovery" }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "ok" } }, "required": ["status"] },
      "then": { "properties": { "code": { "enum": ["ANSWERED", "NO_MATCH", "SPILLED", "EXTRACTED", "STATS", "IMPORTED"] } } } },
    { "if": { "properties": { "status": { "const": "partial" } }, "required": ["status"] },
      "then": { "properties": { "code": { "enum": ["ANSWERED", "NO_MATCH", "EXTRACTED", "LEGACY_COMPACTED", "UPSTREAM_TRUNCATED", "LIMIT_EXCEEDED", "DISCLOSURE_EXHAUSTED", "TIMEOUT", "CANCELLED"] } } } },
    { "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "properties": { "code": { "enum": ["LARGE_READ", "UNCLASSIFIABLE_READ", "UNSAFE_SOURCE", "BINARY_UNSUPPORTED", "HOST_UNSAFE"] } } } },
    { "if": { "properties": { "status": { "const": "error" } }, "required": ["status"] },
      "then": { "properties": { "code": { "enum": ["INVALID_REQUEST", "UNSUPPORTED_VERSION", "UNSAFE_SOURCE", "SOURCE_CHANGED", "SOURCE_EXPIRED", "BINARY_UNSUPPORTED", "LIMIT_EXCEEDED", "TIMEOUT", "MODEL_ERROR", "INVALID_MODEL_OUTPUT", "CITATION_INVALID", "SPILL_FAILED", "STORE_FAILED", "DISCLOSURE_EXHAUSTED", "PROVENANCE_UNAVAILABLE", "HOST_UNSAFE", "CANCELLED"] } } } },
    { "if": { "properties": { "code": { "const": "SPILLED" } }, "required": ["code"] },
      "then": { "properties": { "answer": { "const": "" }, "citations": { "maxItems": 0 } }, "required": ["pointer"] } },
    { "if": { "properties": { "code": { "const": "EXTRACTED" } }, "required": ["code"] },
      "then": { "properties": { "answer": { "const": "" }, "citations": { "maxItems": 0 } }, "required": ["extraction", "result_kind"] } },
    { "if": { "properties": { "code": { "const": "LEGACY_COMPACTED" } }, "required": ["code"] },
      "then": { "properties": { "answer": { "const": "" }, "citations": { "maxItems": 0 } }, "required": ["legacy_compaction", "result_kind"] } },
    { "if": { "properties": { "code": { "const": "STATS" } }, "required": ["code"] },
      "then": { "properties": { "answer": { "const": "" }, "citations": { "maxItems": 0 } }, "required": ["stats", "result_kind"] } },
    { "if": { "properties": { "code": { "const": "IMPORTED" } }, "required": ["code"] },
      "then": { "properties": { "answer": { "const": "" }, "citations": { "maxItems": 0 } }, "required": ["pointer", "import_receipt", "result_kind"] } },
    { "if": { "not": { "properties": { "status": { "const": "ok" } }, "required": ["status"] } },
      "then": { "properties": { "coverage": { "properties": { "complete": { "const": false } } } } } },
    { "if": { "properties": { "schema_version": { "const": "1.1" } }, "required": ["schema_version"] },
      "then": { "required": ["result_kind", "provenance", "accounting_id"] } },
    { "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
      "then": { "allOf": [
        { "not": { "required": ["result_kind"] } },
        { "not": { "required": ["provenance"] } },
        { "not": { "required": ["accounting_id"] } },
        { "not": { "required": ["extraction"] } },
        { "not": { "required": ["legacy_compaction"] } },
        { "not": { "required": ["import_receipt"] } },
        { "not": { "required": ["stats"] } },
        { "not": { "required": ["recovery"] } }
      ] } },
    { "if": { "properties": { "result_kind": { "const": "deterministic_extraction" } }, "required": ["result_kind"] },
      "then": { "properties": { "provenance": { "properties": { "derived": { "const": false } } } } } },
    { "if": { "properties": { "result_kind": { "const": "legacy_compaction" } }, "required": ["result_kind"] },
      "then": { "properties": { "provenance": { "properties": { "derived": { "const": false } } } } } },
    { "if": { "properties": { "result_kind": { "const": "model_derived" } }, "required": ["result_kind"] },
      "then": { "properties": { "provenance": { "properties": { "derived": { "const": true } } } } } }
  ],
  "$defs": {
    "snapshotId": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "sourceId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^src_[A-Za-z0-9]{4,58}$" },
    "tokenMethod": { "enum": ["exact", "bytes_div_4", "unknown", "not_applicable"] },
    "locator": {
      "type": "object",
      "required": ["kind"],
      "oneOf": [
        { "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "const": "all" } } },
        { "additionalProperties": false, "required": ["kind", "start", "end"],
          "properties": { "kind": { "const": "lines" }, "start": { "type": "integer", "minimum": 1, "maximum": 100000000 }, "end": { "type": "integer", "minimum": 1, "maximum": 100000000 } } },
        { "additionalProperties": false, "required": ["kind", "pointer", "start", "end"],
          "properties": { "kind": { "const": "records" }, "pointer": { "type": "string", "maxLength": 1024, "pattern": "^(/([^/~]|~[01])*)*$" }, "start": { "type": "integer", "minimum": 1, "maximum": 100000000 }, "end": { "type": "integer", "minimum": 1, "maximum": 100000000 } } },
        { "additionalProperties": false, "required": ["kind", "pattern", "max_matches"],
          "properties": { "kind": { "const": "search" }, "pattern": { "type": "string", "minLength": 1, "maxLength": 512 }, "max_matches": { "type": "integer", "minimum": 1, "maximum": 200 } } }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "snapshot_id", "locator", "quote", "verified"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 16, "pattern": "^c[0-9]{1,3}$" },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "locator": { "$ref": "#/$defs/locator" },
        "quote": { "type": "string", "minLength": 0, "maxLength": 512 },
        "verified": {
          "description": "Written by the deterministic verifier only. A model-asserted value is never trusted; published citations are always true.",
          "const": true
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["complete", "processed_chunks", "planned_chunks", "omitted", "upstream_truncated"],
      "properties": {
        "complete": { "type": "boolean" },
        "processed_chunks": { "type": "integer", "minimum": 0, "maximum": 8 },
        "planned_chunks": { "type": "integer", "minimum": 0, "maximum": 8 },
        "omitted": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/omission" } },
        "upstream_truncated": { "type": ["boolean", "null"] }
      }
    },
    "omission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "selector", "reason"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "selector": { "$ref": "#/$defs/locator" },
        "reason": {
          "enum": ["BUDGET_EXCEEDED", "TIMEOUT", "CANCELLED", "CHUNK_FAILED", "MODEL_ERROR",
            "INVALID_MODEL_OUTPUT", "CITATION_INVALID", "UPSTREAM_TRUNCATED", "UNKNOWN_REMAINDER",
            "DISCLOSURE_EXHAUSTED", "SCAN_BUDGET_EXHAUSTED", "PROVENANCE_UNAVAILABLE"]
        }
      }
    },
    "sourceHandle": {
      "description": "Non-sensitive handle metadata only. Never an absolute path, preview or secret.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "snapshot_id", "media_type", "bytes", "expires_at"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "media_type": { "enum": ["text/plain", "application/json"] },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "expires_at": { "type": "string", "format": "date-time", "maxLength": 32 }
      }
    },
    "spillPointer": {
      "description": "Spill pointer. Readable only through the registered read-only reader or inspect; carries no payload.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "snapshot_id", "bytes", "expires_at", "internal"],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "expires_at": { "type": "string", "format": "date-time", "maxLength": 32 },
        "internal": {
          "description": "Recursion guard. Verified against the store; a payload that merely claims internal:true is not trusted.",
          "const": true
        }
      }
    },
    "importReceipt": {
      "description": "1.1: which external producer this pointer was adopted from, as bounded tokens re-derived from a validated manifest. It carries no path, no payload, no free text and no producer-supplied timestamp, so an untrusted manifest cannot widen what an envelope may say. artifact_sha256 is the digest of the bytes actually read, not the digest the manifest claimed - the two are proven equal before this block exists.",
      "type": "object",
      "additionalProperties": false,
      "required": ["producer", "manifest_schema", "artifact_sha256", "bytes", "upstream_truncated"],
      "properties": {
        "producer": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
        "manifest_schema": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "origin_tool": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "bytes": { "type": "integer", "minimum": 0, "maximum": 8388608 },
        "upstream_truncated": {
          "description": "true when the producer states the payload was already shortened upstream. The accounting baseline is then the observed size, never the full-payload counterfactual.",
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "description": "1.1: where this envelope's content came from. requested_* is what the adapter asked for; resolved_* is what the host says it selected, if it exposes that; reported_* is what the provider says generated the tokens, if it exposes that. actual_model is never synthesized from requested_model: when nothing can be proven, attribution_status says so.",
      "type": "object",
      "additionalProperties": false,
      "required": ["derived", "label", "attribution_status", "attribution_confidence", "attribution_policy", "attempts_started", "usage_complete", "citations_mechanically_verified"],
      "properties": {
        "derived": {
          "description": "true when any part of answer/guidance was produced by a model. false only for deterministic extraction, gate decisions, pointers and stats.",
          "type": "boolean"
        },
        "label": {
          "enum": ["model_generated_answer", "deterministic_extraction", "legacy_compaction", "gate_decision", "pointer_only", "session_metrics", "no_model_output"]
        },
        "requested_provider": { "type": "string", "maxLength": 64 },
        "requested_model": { "type": "string", "maxLength": 128 },
        "resolved_provider": { "type": ["string", "null"], "maxLength": 64 },
        "resolved_model": { "type": ["string", "null"], "maxLength": 128 },
        "reported_provider": { "type": ["string", "null"], "maxLength": 64 },
        "reported_model": { "type": ["string", "null"], "maxLength": 128 },
        "attribution_status": {
          "description": "actual: the provider reported the generating model and it matched the request. resolved: the host reported its own post-policy selection, not a provider confirmation. unverified: the host returned a value the plugin surface cannot distinguish from an echo of the request. mismatch: a resolved or reported value contradicts the request. unknown: nothing was reported. not_applicable: no model call was made.",
          "enum": ["actual", "resolved", "unverified", "mismatch", "unknown", "not_applicable"]
        },
        "attribution_confidence": { "enum": ["high", "medium", "low", "none"] },
        "attribution_policy": {
          "description": "Which configured policy governed this result. require_match refuses anything below actual/resolved agreement; allow_unverified publishes the truthful unverified label instead of failing closed.",
          "enum": ["require_match", "allow_unverified", "not_applicable"]
        },
        "attempts_started": { "type": "integer", "minimum": 0, "maximum": 64 },
        "usage_complete": {
          "description": "true only when every started attempt returned provider usage. false means at least one attempt's token usage is unknown - never zero.",
          "type": "boolean"
        },
        "citations_mechanically_verified": {
          "description": "true when every published citation was re-checked byte-for-byte against the named snapshot by the deterministic verifier.",
          "type": "boolean"
        },
        "fallback_used": {
          "description": "true when an availability-only fallback attempt produced this result. Availability fallback is never a semantic-quality rescue.",
          "type": "boolean"
        }
      }
    },
    "extraction": {
      "description": "1.1: exact bytes taken from the immutable snapshot. Deterministic, zero model calls, never a summary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_id", "snapshot_id", "deterministic", "segments", "result_bytes", "complete", "lines_scanned", "scan_budget_exhausted", "disclosed_bytes_source", "disclosed_bytes_session", "disclosure_limit_reached"],
      "properties": {
        "mode": { "enum": ["lines", "bytes", "search"] },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "deterministic": { "const": true },
        "segments": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "start", "end", "text"],
            "properties": {
              "kind": { "enum": ["lines", "bytes"] },
              "start": { "type": "integer", "minimum": 0, "maximum": 100000000 },
              "end": { "type": "integer", "minimum": 0, "maximum": 100000000 },
              "text": { "type": "string", "maxLength": 16384 }
            }
          }
        },
        "result_bytes": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "complete": { "type": "boolean" },
        "next_cursor": { "type": ["string", "null"], "maxLength": 512, "pattern": "^csr_[A-Za-z0-9_-]{8,504}$" },
        "lines_scanned": { "type": "integer", "minimum": 0, "maximum": 20000 },
        "scan_budget_exhausted": { "type": "boolean" },
        "matches_found": { "type": "integer", "minimum": 0, "maximum": 200 },
        "disclosed_bytes_source": { "type": "integer", "minimum": 0 },
        "disclosed_bytes_session": { "type": "integer", "minimum": 0 },
        "disclosure_limit_reached": { "type": "boolean" }
      }
    },
    "legacyCompaction": {
      "description": "1.1: a deterministic heuristic summary produced only after a reader (model) failure, ported from the incumbent tool-result compactor. Never exact snapshot bytes (see extraction for that) and never model-derived - provenance.derived is always false for this block. original_failure names the reader outcome this summary stands in for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "source_id", "snapshot_id", "summary", "summary_bytes", "original_bytes", "hard_cap_chars", "original_failure"],
      "properties": {
        "deterministic": { "const": true },
        "source_id": { "$ref": "#/$defs/sourceId" },
        "snapshot_id": { "$ref": "#/$defs/snapshotId" },
        "summary": { "type": "string", "maxLength": 16384 },
        "summary_bytes": { "type": "integer", "minimum": 0, "maximum": 16384 },
        "original_bytes": { "type": "integer", "minimum": 0 },
        "hard_cap_chars": { "type": "integer", "minimum": 1 },
        "original_failure": {
          "description": "The reader outcome this deterministic summary stands in for. Never a provider error body or free text.",
          "enum": ["MODEL_ERROR", "TIMEOUT", "INVALID_MODEL_OUTPUT", "CITATION_INVALID"]
        }
      }
    },
    "stats": {
      "description": "1.1: this session's own aggregate plus one bounded page of operation records. Never another session, never content, never a high-cardinality label.",
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "totals", "records", "page", "page_size", "total_records"],
      "properties": {
        "scope": { "const": "session" },
        "totals": { "$ref": "#/$defs/statsTotals" },
        "records": { "type": "array", "maxItems": 8, "items": { "$ref": "#/$defs/operationRecord" } },
        "page": { "type": "integer", "minimum": 1, "maximum": 64 },
        "page_size": { "type": "integer", "minimum": 1, "maximum": 8 },
        "total_records": { "type": "integer", "minimum": 0 },
        "next_page": { "type": ["integer", "null"], "minimum": 2, "maximum": 64 }
      }
    },
    "statsTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operations", "raw_input_bytes", "baseline_credit_tokens", "main_model_envelope_tokens", "main_context_tokens_saved", "net_tokens_saved", "attempts_started", "attempts_usage_complete", "disclosed_bytes"],
      "properties": {
        "operations": { "type": "integer", "minimum": 0 },
        "raw_input_bytes": { "type": "integer", "minimum": 0 },
        "baseline_credit_tokens": { "type": "integer", "minimum": 0 },
        "main_model_envelope_tokens": { "type": "integer", "minimum": 0 },
        "reader_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reader_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reader_cache_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "main_context_tokens_saved": { "type": "integer" },
        "net_tokens_saved": { "type": "integer" },
        "attempts_started": { "type": "integer", "minimum": 0 },
        "attempts_usage_complete": { "type": "integer", "minimum": 0 },
        "disclosed_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "operationRecord": {
      "description": "Bounded non-content metadata for one operation. A null token field means not reported and MUST NOT be rendered as zero.",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_id", "kind", "status", "code", "raw_input_bytes", "baseline_kind", "baseline_method", "baseline_credit_tokens", "main_model_envelope_bytes", "main_model_envelope_tokens", "envelope_token_method", "reader_token_method", "attempts_started", "attempts_usage_complete", "delivery_boundary", "main_context_tokens_saved", "net_tokens_saved"],
      "properties": {
        "operation_id": { "type": "string", "pattern": "^acc_[0-9a-f]{16}$" },
        "kind": { "enum": ["gate_block", "capture", "read", "refined_read", "inspect", "stats", "spill"] },
        "status": { "enum": ["ok", "partial", "blocked", "error"] },
        "code": { "type": "string", "maxLength": 32, "pattern": "^[A-Z_]+$" },
        "raw_input_bytes": { "type": "integer", "minimum": 0 },
        "raw_input_baseline_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "baseline_kind": { "enum": ["full_payload_counterfactual", "host_truncated_observed", "none"] },
        "baseline_method": { "enum": ["exact", "bytes_div_4", "unknown"] },
        "baseline_credit_tokens": { "type": "integer", "minimum": 0 },
        "main_model_envelope_bytes": { "type": "integer", "minimum": 0 },
        "main_model_envelope_tokens": { "type": "integer", "minimum": 0 },
        "envelope_token_method": { "enum": ["exact", "bytes_div_4", "unknown"] },
        "reader_input_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reader_output_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reader_cache_tokens": { "type": ["integer", "null"], "minimum": 0 },
        "reader_token_method": { "$ref": "#/$defs/tokenMethod" },
        "attempts_started": { "type": "integer", "minimum": 0 },
        "attempts_usage_complete": { "type": "integer", "minimum": 0 },
        "delivery_boundary": { "enum": ["envelope", "extraction", "pointer", "block_message", "none"] },
        "main_context_tokens_saved": { "type": "integer" },
        "net_tokens_saved": { "type": "integer" }
      }
    },
    "recovery": {
      "description": "1.1: deterministic next steps after a failure. handles_valid states whether the caller's handles survived, so a reader failure never forces a recapture.",
      "type": "object",
      "additionalProperties": false,
      "required": ["handles_valid", "actions"],
      "properties": {
        "handles_valid": { "type": "boolean" },
        "actions": {
          "type": "array",
          "maxItems": 6,
          "items": {
            "enum": ["RETRY_SAME_QUESTION", "REFINE_QUESTION_SAME_SNAPSHOT", "INSPECT_HANDLE",
              "NARROW_SELECTOR", "WAIT_AND_RETRY", "RECAPTURE_SOURCE", "CONFIGURE_READER_MODEL",
              "REVIEW_DISCLOSURE_BUDGET", "NONE"]
          }
        }
      }
    }
  }
}
