#!/usr/bin/env python3
"""Acceptance entry point: ``scripts/verify <suite> <gate> [options]``.

Exit codes are the contract:

* ``0``  every *required* gate passed, and each one collected at least one case.
* ``1``  an assertion failed, a corpus was empty, or a gate is not implemented.
* ``2``  a required gate needs a prerequisite that is absent (a live host, a live model).
         It is reported as ``NOT_RUN`` - never as a pass, and never silently skipped.

Deterministic gates never report ``NOT_RUN``: they run from the repository alone. Opt-in
gates (real host integration, live Luna evals, provider benchmarks) say what is missing.

Required, unavailable, and unsupported are three different things
-----------------------------------------------------------------
``NOT_RUN`` used to cover two unlike states, and that made ``release all`` incapable of
exiting 0 in any environment. A live reader gate with no bridge is a *required* gate whose
prerequisite is absent - the release is not verified until it runs, so it must block. The
oversized post-tool mode and the shadow reader lane are different: both are disabled *by
design*, on evidence recorded in ``docs/capability-matrix.md`` and in ``run_shadow``
respectively, and no environment will ever make them run. Waiting for them is waiting for
something that is not coming.

They are now reported as ``EXPECTED_UNSUPPORTED``, which is printed, counted and written
to the report separately, and does not block. Every other absent prerequisite still
blocks, so ``release all`` exits 0 exactly when every required gate passed.

The ``shadow`` suite is deliberately split the same way. ``shadow deterministic`` runs
from the repository and reports the two gates that can be measured without a provider;
``shadow reader`` needs a live reader bridge and reports ``NOT_RUN`` without one, so the
provider-dependent gates are never scored from a lane that cannot answer a question.

Every run appends a non-sensitive report to ``reports/`` (gitignored): suite, gate,
counts, exit code, duration and tool versions. No source content, question, answer or
path from a fixture is written there.
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import platform
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import zipfile
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
REPORTS = ROOT / "reports"
PY = ROOT / ".venv" / "bin" / "python"
NODE_BIN = ROOT / "node_modules" / ".bin"

EXIT_OK, EXIT_FAIL, EXIT_NOT_RUN = 0, 1, 2

#: A gate that is disabled by design and will not run in any environment. Distinct from
#: ``not_run``, which is a required gate whose prerequisite happens to be absent here.
STATUS_EXPECTED_UNSUPPORTED = "expected_unsupported"

CORE_TS = ROOT / "packages" / "core-ts"
OPENCLAW_ADAPTER = ROOT / "adapters" / "openclaw"

# gate -> (pytest marker, [vitest project/file pairs])
UNIT_GATES: dict[str, tuple[str, list[tuple[Path, str]]]] = {
    "contract": ("gate_contract", [(CORE_TS, "test/contract.test.ts")]),
    "pre-read": ("gate_pre_read", [(CORE_TS, "test/gate.test.ts")]),
    "reader": ("gate_reader", [(CORE_TS, "test/reader-and-spill.test.ts")]),
    "citations": ("gate_citations", [(CORE_TS, "test/citations.test.ts")]),
    "no-raw-leak": ("gate_no_raw_leak", [(CORE_TS, "test/reader-and-spill.test.ts")]),
    "bounded-output": (
        "gate_bounded_output",
        [(CORE_TS, "test/reader-and-spill.test.ts")],
    ),
    "cancellation": ("gate_cancellation", [(CORE_TS, "test/reader-and-spill.test.ts")]),
    "permissions": ("gate_permissions", [(CORE_TS, "test/permissions.test.ts")]),
    "no-writes": ("gate_no_writes", [(CORE_TS, "test/reader-and-spill.test.ts")]),
    "capability": ("gate_capability", [(OPENCLAW_ADAPTER, "test/adapter.test.ts")]),
    "store": ("gate_store", [(CORE_TS, "test/store.test.ts")]),
    "inspect": ("gate_inspect", [(CORE_TS, "test/inspect.test.ts")]),
    "accounting": ("gate_accounting", [(CORE_TS, "test/accounting.test.ts")]),
    # Python-only: the import boundary lives in the Python core, and the OpenClaw
    # capability report says so rather than implying a TypeScript twin exists.
    "artifact-import": ("gate_artifact_import", []),
    # Python-only: what each *live reader route* actually does. Deterministic - it drives
    # each bridge against a stub - and it is what makes the live gates' refusal to score
    # through a role-collapsing route trustworthy rather than a comment.
    "bridge-contract": ("bridge_contract", []),
}

SHADOW_GATES = ("deterministic", "reader")

INTEGRATION_HOSTS = ("hermes", "openclaw")
INTEGRATION_MODES = ("local", "post-tool", "unsupported")


@dataclass
class GateResult:
    suite: str
    gate: str
    status: str  # pass | fail | not_run
    cases: int = 0
    detail: str = ""
    duration_s: float = 0.0
    lines: list[str] = field(default_factory=list)

    @property
    def exit_code(self) -> int:
        return {
            "pass": EXIT_OK,
            "fail": EXIT_FAIL,
            "not_run": EXIT_NOT_RUN,
            STATUS_EXPECTED_UNSUPPORTED: EXIT_OK,
        }[self.status]

    @property
    def blocks_release(self) -> bool:
        """Whether this result stops a release. An unsupported-by-design gate does not."""
        return self.status in ("fail", "not_run")


# -- process helpers -------------------------------------------------------


def _run(cmd: list[str], cwd: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)


def _python() -> str | None:
    if PY.exists():
        return str(PY)
    return shutil.which("python3")


def _pytest(marker: str) -> tuple[str, int, str]:
    interpreter = _python()
    if interpreter is None:
        return "not_run", 0, "python3 not found"
    proc = _run([interpreter, "-m", "pytest", "-m", marker, "-q", "--no-header"], ROOT)
    cases = _pytest_count(proc.stdout)
    if proc.returncode == 5 or cases == 0:
        # pytest exit 5 is "no tests collected". An empty gate is a failure, not a pass.
        return "fail", 0, "no cases collected"
    if proc.returncode != 0:
        return "fail", cases, _tail(proc.stdout or proc.stderr)
    return "pass", cases, ""


_COUNTED_OUTCOMES = ("passed", "failed", "error", "errors", "xfailed", "xpassed")


def _pytest_count(output: str) -> int:
    """Count executed cases only. `deselected` and `skipped` are not executed cases."""
    for line in reversed(output.strip().splitlines()):
        if not any(f" {word}" in line for word in _COUNTED_OUTCOMES):
            continue
        tokens = line.replace(",", " ").replace("=", " ").split()
        total = 0
        for index, token in enumerate(tokens[:-1]):
            if token.isdigit() and tokens[index + 1].rstrip(".") in _COUNTED_OUTCOMES:
                total += int(token)
        if total:
            return total
    return 0


def _vitest(project: Path, target: str) -> tuple[str, int, str]:
    binary = NODE_BIN / "vitest"
    if not binary.exists():
        return "not_run", 0, "node_modules missing (run: npm install)"
    proc = _run([str(binary), "run", target, "--reporter=json"], project)
    cases, failed = _vitest_counts(proc.stdout)
    if cases == 0:
        return "fail", 0, "no cases collected"
    if proc.returncode != 0 or failed:
        return "fail", cases, f"{failed} failing"
    return "pass", cases, ""


def _vitest_counts(output: str) -> tuple[int, int]:
    start = output.find("{")
    if start < 0:
        return 0, 0
    try:
        parsed = json.loads(output[start:])
    except ValueError:
        return 0, 0
    passed = int(parsed.get("numPassedTests", 0))
    failed = int(parsed.get("numFailedTests", 0))
    # Vitest's numTotalTests includes skipped/pending cases. Reports count only cases
    # that actually executed, matching the pytest side and this verifier's contract.
    return passed + failed, failed


def _tail(text: str, lines: int = 12) -> str:
    return "\n".join(text.strip().splitlines()[-lines:])


# -- suites ----------------------------------------------------------------


def run_unit(gate: str) -> list[GateResult]:
    if gate == "all":
        results: list[GateResult] = [run_contract_sync()]
        for name in UNIT_GATES:
            results.extend(run_unit(name))
        return results
    if gate not in UNIT_GATES:
        return [
            GateResult(
                "unit",
                gate,
                "fail",
                detail=f"unknown gate; known: {', '.join(UNIT_GATES)}",
            )
        ]

    marker, ts_targets = UNIT_GATES[gate]
    started = time.monotonic()
    status, cases, detail = _pytest(marker)
    lines = [f"python  {marker}: {status} ({cases} cases) {detail}".rstrip()]
    for project, target in ts_targets:
        ts_status, ts_cases, ts_detail = _vitest(project, target)
        lines.append(
            f"node    {project.name}/{target}: {ts_status} ({ts_cases} cases) {ts_detail}".rstrip()
        )
        cases += ts_cases
        if ts_status == "fail":
            status, detail = "fail", ts_detail
        elif ts_status == "not_run" and status == "pass":
            status, detail = "not_run", ts_detail
    return [
        GateResult(
            "unit", gate, status, cases, detail, time.monotonic() - started, lines
        )
    ]


def run_contract_sync() -> GateResult:
    """The vendored contract copies must match `contracts/v1` byte for byte."""
    started = time.monotonic()
    proc = _run(
        [sys.executable, str(ROOT / "scripts" / "sync-contracts"), "--check"], ROOT
    )
    status = "pass" if proc.returncode == 0 else "fail"
    return GateResult(
        "unit",
        "contract-sync",
        status,
        1,
        _tail(proc.stderr),
        time.monotonic() - started,
        [f"contracts vendored copies: {status}"],
    )


def _hermes_prereq() -> tuple[bool, str]:
    root = os.environ.get("CONTEXT_SHUNT_HERMES_ROOT", "")
    interpreter = os.environ.get("CONTEXT_SHUNT_HERMES_PYTHON", "")
    if not root or not Path(root).is_dir():
        return False, "set CONTEXT_SHUNT_HERMES_ROOT to a hermes-agent checkout"
    if not interpreter or not Path(interpreter).exists():
        return (
            False,
            "set CONTEXT_SHUNT_HERMES_PYTHON to an interpreter with hermes-agent installed",
        )
    return True, ""


def _openclaw_prereq() -> tuple[bool, str]:
    root = os.environ.get("CONTEXT_SHUNT_OPENCLAW_ROOT", "")
    if not root or not Path(root).is_dir():
        return False, "set CONTEXT_SHUNT_OPENCLAW_ROOT to an OpenClaw checkout"
    if not (Path(root) / "package.json").exists():
        return (
            False,
            "CONTEXT_SHUNT_OPENCLAW_ROOT does not look like an OpenClaw checkout",
        )
    return True, ""


#: Properties a route must have before a *live* number measured through it may be reported
#: as this project's. All three are about whether the measurement describes the product: a
#: route that folds the system prompt into the user turn is answering a different prompt,
#: one that drops ``max_output_tokens`` is not making the bounded call the reader budgets
#: for, and one that is not production-equivalent reaches the model by a path the shipped
#: adapter does not use.
#:
#: ``production_equivalent`` is the strictest of the three and was added last, deliberately.
#: A route can preserve roles and enforce the cap and still not be the product: the shipped
#: adapter reaches the model through the isolated agent runtime, and a route that bypasses
#: it measures a different stack. Every route in this repository declares
#: ``production_equivalent: false`` and says why in its own ``production_gap``, so a
#: release-quality live number cannot be produced here at all - which is the truthful
#: answer, and better than a number this project would have to caveat into meaninglessness.
#: `unit bridge-contract` verifies each route against its own declaration.
REQUIRED_BRIDGE_PROPERTIES = ("preserves_roles", "enforces_output_cap", "production_equivalent")


def _bridge_descriptor(spec: str) -> tuple[dict | None, str]:
    """Import ``module:callable`` the way an operator does and read its ``BRIDGE`` block."""
    module_name = spec.partition(":")[0]
    evals = str(ROOT / "evals")
    if evals not in sys.path:
        sys.path.insert(0, evals)
    try:
        import importlib

        module = importlib.import_module(module_name)
    except Exception as exc:  # noqa: BLE001 - the reason is reported, not raised
        return None, f"bridge {module_name!r} could not be imported ({type(exc).__name__})"
    descriptor = getattr(module, "BRIDGE", None)
    if not isinstance(descriptor, dict):
        return None, f"bridge {module_name!r} declares no BRIDGE descriptor"
    return descriptor, ""


def _luna_prereq() -> tuple[bool, str]:
    """What a live reader gate needs before its number can describe this project.

    Three separate things, and the third is the one that was missing. The opt-in flag says
    an operator intends a live run; the bridge spec says which route; and the route's own
    declaration says whether a measurement through it describes the product at all. Scoring
    through a role-collapsing, cap-dropping route produced a number about a different prompt
    under no ceiling, which is worse than no number.
    """
    if not os.environ.get("CONTEXT_SHUNT_LUNA_EVAL"):
        return False, (
            "set CONTEXT_SHUNT_LUNA_EVAL=1 and provide a host bridge that serves "
            "gpt-5.6-luna; a mock is never a pass"
        )
    spec = os.environ.get("CONTEXT_SHUNT_LUNA_BRIDGE", "")
    if not spec or ":" not in spec:
        return False, "set CONTEXT_SHUNT_LUNA_BRIDGE=module:callable naming a live route"
    descriptor, why = _bridge_descriptor(spec)
    if descriptor is None:
        return False, why
    lacking = [key for key in REQUIRED_BRIDGE_PROPERTIES if not descriptor.get(key)]
    if lacking:
        return False, (
            f"route {descriptor.get('id', spec)!r} lacks {', '.join(lacking)}: "
            f"{descriptor.get('production_gap', 'no reason declared')}. A live number "
            "measured through it would not describe this reader"
        )
    return True, ""


def run_integration(host: str, mode: str) -> list[GateResult]:
    if host == "all":
        results: list[GateResult] = []
        for name in INTEGRATION_HOSTS:
            # "all" with an explicit --mode runs that mode on both hosts; the default
            # walks every mode so `integration all` covers the whole matrix once.
            modes = INTEGRATION_MODES if mode == "local" else (mode,)
            for each in modes:
                results.extend(run_integration(name, each))
        return results
    if host not in INTEGRATION_HOSTS:
        return [
            GateResult(
                "integration",
                host,
                "fail",
                detail=f"unknown host; known: {', '.join(INTEGRATION_HOSTS)}",
            )
        ]
    if mode not in INTEGRATION_MODES:
        return [
            GateResult(
                "integration",
                f"{host}/{mode}",
                "fail",
                detail=f"unknown mode; known: {', '.join(INTEGRATION_MODES)}",
            )
        ]

    gate = f"{host} --mode {mode}"
    started = time.monotonic()

    if mode == "unsupported":
        # Fail-closed behaviour is ours, not the host's, so this gate is deterministic:
        # it proves the adapter refuses the mode and keeps the local gate working.
        marker = "gate_capability"
        status, cases, detail = _pytest(marker)
        project = OPENCLAW_ADAPTER if host == "openclaw" else None
        lines = [f"python  {marker}: {status} ({cases} cases)"]
        if project is not None:
            ts_status, ts_cases, ts_detail = _vitest(project, "test/adapter.test.ts")
            lines.append(
                f"node    adapter fail-closed: {ts_status} ({ts_cases} cases) {ts_detail}".rstrip()
            )
            cases += ts_cases
            if ts_status != "pass":
                status, detail = ts_status, ts_detail
        return [
            GateResult(
                "integration",
                gate,
                status,
                cases,
                detail,
                time.monotonic() - started,
                lines,
            )
        ]

    if mode == "post-tool":
        # Both supported hosts are proven unable to give the required capture/replacement
        # order (docs/capability-matrix.md), so this gate will not run in any environment
        # - it is disabled by design, not waiting on a prerequisite. Decided *before* the
        # host prerequisite for exactly that reason: producing a checkout would not change
        # the answer, and reporting "missing prerequisite" implied it would. The
        # fail-closed behaviour is still gated, deterministically, by `--mode unsupported`.
        return [
            GateResult(
                "integration",
                gate,
                STATUS_EXPECTED_UNSUPPORTED,
                0,
                "mode disabled on this host: capture happens after truncation "
                "(see docs/capability-matrix.md); run --mode unsupported instead",
                time.monotonic() - started,
                [
                    f"EXPECTED_UNSUPPORTED {gate}: the mode stays disabled on this host, "
                    "and no environment enables it"
                ],
            )
        ]

    ok, why = _hermes_prereq() if host == "hermes" else _openclaw_prereq()
    if not ok:
        return [
            GateResult(
                "integration",
                gate,
                "not_run",
                0,
                f"prerequisite missing: {why}",
                time.monotonic() - started,
                [f"NOT_RUN {gate}: {why}"],
            )
        ]

    if host == "openclaw":
        ts_status, ts_cases, ts_detail = _vitest(
            OPENCLAW_ADAPTER, "test/host-integration.test.ts"
        )
        return [
            GateResult(
                "integration",
                gate,
                ts_status,
                ts_cases,
                ts_detail,
                time.monotonic() - started,
                [
                    f"node    openclaw host checkout: {ts_status} ({ts_cases} cases) {ts_detail}".rstrip()
                ],
            )
        ]

    marker = f"integration_{host}"
    status, cases, detail = _pytest(marker)
    return [
        GateResult(
            "integration",
            gate,
            status,
            cases,
            detail,
            time.monotonic() - started,
            [f"python  {marker}: {status} ({cases} cases) {detail}".rstrip()],
        )
    ]


def run_eval(gate: str) -> list[GateResult]:
    if gate != "luna":
        return [GateResult("eval", gate, "fail", detail="unknown gate; known: luna")]
    started = time.monotonic()
    ok, why = _luna_prereq()
    if not ok:
        return [
            GateResult(
                "eval",
                "luna",
                "not_run",
                0,
                f"prerequisite missing: {why}",
                time.monotonic() - started,
                [f"NOT_RUN eval luna: {why}"],
            )
        ]
    status, cases, detail = _pytest("eval_luna")
    return [
        GateResult("eval", "luna", status, cases, detail, time.monotonic() - started)
    ]


def run_benchmark(gate: str) -> list[GateResult]:
    started = time.monotonic()
    if gate == "core":
        status, cases, detail = _pytest("benchmark")
        return [
            GateResult(
                "benchmark", "core", status, cases, detail, time.monotonic() - started
            )
        ]
    if gate != "all":
        return [
            GateResult(
                "benchmark", gate, "fail", detail="unknown gate; known: core, all"
            )
        ]
    results = run_benchmark("core")
    results.append(run_benchmark_provider())
    return results


def run_benchmark_provider() -> GateResult:
    """The provider half. NOT_RUN without live access; a real measurement with it.

    This used to be hardcoded to NOT_RUN, which meant the gate could never run even where
    live access existed - the prerequisite was never actually consulted. It now checks the
    same prerequisite as ``eval luna`` and runs the measurement when it is satisfied.

    That prerequisite includes the *route's* properties, and it matters more here than
    anywhere: latency and token cost are the two numbers a role-collapsing, cap-dropping
    route would misdescribe most directly. A completion the provider was never given a
    ceiling for is not the bounded call this reader makes.
    """
    started = time.monotonic()
    ok, why = _luna_prereq()
    if not ok:
        return GateResult(
            "benchmark",
            "provider",
            "not_run",
            0,
            f"prerequisite missing: reader latency and token cost need a live route - {why}",
            time.monotonic() - started,
            [f"NOT_RUN benchmark provider: {why}"],
        )
    status, cases, detail = _pytest("benchmark_provider")
    return GateResult(
        "benchmark", "provider", status, cases, detail, time.monotonic() - started
    )


def run_shadow(gate: str) -> list[GateResult]:
    """The shadow A/B comparison, split by what can honestly be measured here."""
    if gate == "all":
        results: list[GateResult] = []
        for name in SHADOW_GATES:
            results.extend(run_shadow(name))
        return results
    if gate not in SHADOW_GATES:
        return [
            GateResult(
                "shadow",
                gate,
                "fail",
                detail=f"unknown gate; known: {', '.join(SHADOW_GATES)}, all",
            )
        ]

    started = time.monotonic()
    if gate == "deterministic":
        status, cases, detail = _pytest("shadow_ab")
        lines = _shadow_report_lines()
        return [
            GateResult(
                "shadow",
                gate,
                status,
                cases,
                detail,
                time.monotonic() - started,
                lines,
            )
        ]

    # The reader half is *unconditionally* NOT_RUN, and that is a decision rather than a
    # missing prerequisite. Scoring a model lane needs a fixed corpus, fixed thresholds
    # and a fixed number of runs per item, decided before the run; `eval luna` is the gate
    # that owns those controls. Keying this off an environment variable instead would have
    # printed PASS from the deterministic marker the moment a bridge appeared - the same
    # false pass `run_benchmark_provider` was fixed for, in the opposite direction.
    return [
        GateResult(
            "shadow",
            "reader",
            STATUS_EXPECTED_UNSUPPORTED,
            0,
            "not scored here by design: task correctness, semantic evidence support, "
            "mechanical citation validity and follow-up rate are the live reader eval's "
            "gates (scripts/verify eval luna owns the fixed corpus and thresholds). Net "
            "cost reduction additionally needs a versioned pricing table, which this "
            "repository does not have.",
            time.monotonic() - started,
            [
                "EXPECTED_UNSUPPORTED shadow reader: scored by `verify eval luna`, "
                "not by this harness",
                "EXPECTED_UNSUPPORTED shadow net-cost: no pricing table exists in this "
                "repository",
            ],
        )
    ]


def _shadow_report_lines() -> list[str]:
    """Summarize the report the shadow run wrote, without restating any of its content."""
    path = REPORTS / "shadow-ab-latest.json"
    if not path.exists():
        return []
    try:
        report = json.loads(path.read_text())
    except (OSError, ValueError):
        return ["shadow report unreadable"]
    lines: list[str] = []
    for name, gate in (report.get("gates") or {}).items():
        state = str(gate.get("status", "unknown")).lower()
        if state == "not_run":
            lines.append(f"NOT_RUN {name}: needs {gate.get('missing', 'a prerequisite')}")
            continue
        measured = gate.get("measured", gate.get("measured_ms"))
        threshold = gate.get("threshold", gate.get("threshold_ms"))
        lines.append(f"{state.upper():7s} {name}: {measured} (threshold {threshold})")
    return lines


def run_packaging(gate: str) -> list[GateResult]:
    if gate != "all":
        return [
            GateResult("packaging", gate, "fail", detail="unknown gate; known: all")
        ]
    started = time.monotonic()
    lines: list[str] = []
    failures: list[str] = []
    checks = 0

    # 1. The TypeScript core builds, and the build output is what the package ships.
    tsc = NODE_BIN / "tsc"
    if not tsc.exists():
        return [
            GateResult(
                "packaging",
                "all",
                "not_run",
                0,
                "node_modules missing (run: npm install)",
            )
        ]
    for project in (
        CORE_TS / "tsconfig.build.json",
        OPENCLAW_ADAPTER / "tsconfig.json",
    ):
        checks += 1
        proc = _run([str(tsc), "-p", str(project), "--noEmit"], ROOT)
        ok = proc.returncode == 0
        lines.append(f"typecheck {project.parent.name}: {'pass' if ok else 'fail'}")
        if not ok:
            failures.append(f"typecheck failed: {project}")
    checks += 1
    proc = _run([str(tsc), "-p", str(CORE_TS / "tsconfig.build.json")], ROOT)
    built = (CORE_TS / "dist" / "index.js").exists()
    lines.append(
        f"build @context-shunt/core: {'pass' if proc.returncode == 0 and built else 'fail'}"
    )
    if proc.returncode != 0 or not built:
        failures.append("core-ts build did not produce dist/index.js")

    # 2. The built package resolves its vendored contracts from dist/, which is the
    #    shape an installed plugin actually runs in.
    checks += 1
    probe = (
        "import('./packages/core-ts/dist/index.js').then(m=>{"
        "if(m.DEFAULT_LIMITS.fullReadMaxLines!==350)throw new Error('limits');"
        "if(m.READER_MODEL!=='gpt-5.6-luna')throw new Error('model');"
        "if(m.EMITTED_SCHEMA_VERSION!=='1.1')throw new Error('contract revision');"
        "if(!m.storeDdl().includes('CREATE TABLE IF NOT EXISTS handles'))"
        "throw new Error('store DDL missing from dist');"
        "m.requestValidator();m.toolArgsValidator();console.log('OK')})"
        ".catch(e=>{console.error(e.message);process.exit(1)})"
    )
    proc = _run(["node", "-e", probe], ROOT)
    ok = proc.returncode == 0 and "OK" in proc.stdout
    lines.append(f"dist resolves vendored contracts: {'pass' if ok else 'fail'}")
    if not ok:
        failures.append("built dist cannot load its vendored contracts")

    # 3. Both packages declare the files they ship, and ship the contracts with them.
    for manifest, required in (
        (CORE_TS / "package.json", ["dist", "contracts"]),
        (
            OPENCLAW_ADAPTER / "package.json",
            ["index.ts", "src", "openclaw.plugin.json"],
        ),
    ):
        checks += 1
        data = json.loads(manifest.read_text())
        missing = [
            entry for entry in required if entry not in (data.get("files") or [])
        ]
        lines.append(
            f"{manifest.parent.name} files[]: {'pass' if not missing else 'fail'}"
        )
        if missing:
            failures.append(f"{manifest} files[] is missing {missing}")

    # 4. Both packages ship the vendored contracts *including the store DDL*, which is
    #    executed at runtime - a package without it cannot open a store at all.
    for label, root in (
        ("core-py", ROOT / "packages" / "core-py" / "src" / "context_shunt" / "contracts"),
        ("core-ts", CORE_TS / "contracts"),
    ):
        checks += 1
        ok = (
            (root / "v1" / "limits.json").exists()
            and (root / "v1" / "request.schema.json").exists()
            and (root / "v1" / "tool-args.schema.json").exists()
            and (root / "store" / "v1.sql").exists()
        )
        lines.append(f"{label} vendored contracts (incl. store DDL): {'pass' if ok else 'fail'}")
        if not ok:
            failures.append(f"{label} vendored contracts are missing or incomplete")

    # 4b. The Python wheel's package-data globs actually cover the DDL.
    checks += 1
    pyproject = (ROOT / "packages" / "core-py" / "pyproject.toml").read_text()
    ok = "contracts/store/*.sql" in pyproject
    lines.append(f"core-py package-data covers the store DDL: {'pass' if ok else 'fail'}")
    if not ok:
        failures.append("core-py package-data does not ship contracts/store/*.sql")

    # 5. Inspect the actual archives, then install/import/uninstall them in clean roots.
    artifact_checks, artifact_lines, artifact_failures = _artifact_install_smoke()
    checks += artifact_checks
    lines.extend(artifact_lines)
    failures.extend(artifact_failures)

    # 6. Defaults are safe: post-tool off, writer unavailable, caps at contract values.
    checks += 1
    example = ROOT / "examples" / "config" / "openclaw.json"
    hermes_example = ROOT / "examples" / "config" / "hermes.config.yaml"
    ok = example.exists() and hermes_example.exists()
    if ok:
        cfg = json.loads(example.read_text())
        entry = cfg["plugins"]["entries"]["context-shunt"]["config"]
        ok = entry["suma_post_tool"]["enabled"] is False and "writer" not in entry
        ok = ok and "propose_patch" not in example.read_text()
    lines.append(
        f"example config defaults (post-tool off, no writer): {'pass' if ok else 'fail'}"
    )
    if not ok:
        failures.append("example configuration does not carry safe defaults")

    # 6b. The example actually loads. A documented configuration that the real loader
    #     rejects is worse than no example, so this runs it through the loader itself.
    checks += 1
    ok, detail = _example_config_loads(example)
    lines.append(f"example config loads through the real loader: {'pass' if ok else 'fail'}")
    if not ok:
        failures.append(detail)

    # 7. Nothing shippable contains a spill, a report, a secret or a local path.
    checks += 1
    leaked = _release_artifact_scan()
    lines.append(f"release artifact scan: {'pass' if not leaked else 'fail'}")
    if leaked:
        failures.append(f"disallowed content in shippable files: {leaked}")

    # 8. Session teardown removes private artifacts.
    checks += 1
    ok, detail = _uninstall_smoke()
    lines.append(
        f"session teardown clears private artifacts: {'pass' if ok else 'fail'}"
    )
    if not ok:
        failures.append(detail)

    status = "pass" if not failures else "fail"
    return [
        GateResult(
            "packaging",
            "all",
            status,
            checks,
            "; ".join(failures),
            time.monotonic() - started,
            lines,
        )
    ]


def _example_config_loads(example: Path) -> tuple[bool, str]:
    """The documented configuration must be one the loader accepts, key for key."""
    interpreter = _python()
    if interpreter is None:
        return False, "python3 not found"
    script = (
        "import json, pathlib, sys, tempfile;"
        'sys.path.insert(0, "packages/core-py/src");'
        "from context_shunt.config import load;"
        f"raw = json.loads(pathlib.Path({str(example)!r}).read_text());"
        'cfg = raw["plugins"]["entries"]["context-shunt"]["config"];'
        "root = pathlib.Path(tempfile.mkdtemp());"
        '(root / "ws").mkdir();'
        'cfg = {**cfg, "workspace_roots": [str(root / "ws")],'
        '       "cache_dir": str(root / "cache")};'
        "loaded = load(cfg, default_spill_dir=root / 'cache');"
        "assert loaded.suma_post_tool.enabled is False;"
        "assert loaded.reader.model == 'gpt-5.6-luna';"
        'print("OK")'
    )
    proc = _run([interpreter, "-c", script], ROOT)
    if proc.returncode != 0 or "OK" not in proc.stdout:
        return False, f"example config is not loadable: {_tail(proc.stderr or proc.stdout, 3)}"
    return True, ""


def _artifact_install_smoke() -> tuple[int, list[str], list[str]]:
    """Pack what will be published, inspect it, and use clean install roots."""
    lines: list[str] = []
    failures: list[str] = []
    checks = 0
    interpreter = _python()
    npm = shutil.which("npm")
    if interpreter is None or npm is None:
        return 1, ["archive install smoke: fail"], ["python3 or npm not found"]

    with tempfile.TemporaryDirectory(prefix="context-shunt-package-") as raw_temp:
        temp = Path(raw_temp)
        archives = temp / "archives"
        archives.mkdir()

        packed: dict[str, Path] = {}
        for label, project in (("core", CORE_TS), ("openclaw", OPENCLAW_ADAPTER)):
            proc = _run(
                [npm, "pack", "--json", "--pack-destination", str(archives)], project
            )
            try:
                metadata = json.loads(proc.stdout)
                filename = metadata[0]["filename"]
                archive = archives / filename
            except (ValueError, KeyError, IndexError, TypeError):
                archive = Path()
            packed[label] = archive

        checks += 1
        npm_contents_ok = all(path.is_file() for path in packed.values())
        if npm_contents_ok:
            expected = {
                "core": (
                    "package/LICENSE",
                    "package/dist/index.js",
                    "package/contracts/v1/limits.json",
                    "package/contracts/v1/tool-args.schema.json",
                    # The store DDL is executed at runtime, so a package without it is
                    # unusable rather than merely incomplete.
                    "package/contracts/store/v1.sql",
                ),
                "openclaw": (
                    "package/LICENSE",
                    "package/index.ts",
                    "package/openclaw.plugin.json",
                ),
            }
            for label, archive in packed.items():
                try:
                    with tarfile.open(archive, "r:gz") as bundle:
                        names = set(bundle.getnames())
                    npm_contents_ok = npm_contents_ok and all(
                        name in names for name in expected[label]
                    )
                except (OSError, tarfile.TarError):
                    npm_contents_ok = False
        lines.append(
            f"npm archives include runtime, contracts, license: {'pass' if npm_contents_ok else 'fail'}"
        )
        if not npm_contents_ok:
            failures.append("npm archive contents are incomplete")

        js_root = temp / "node-install"
        js_root.mkdir()
        (js_root / "package.json").write_text(
            '{"name":"shunt-install-smoke","private":true,"type":"module"}\n'
        )
        checks += 1
        npm_install_ok = npm_contents_ok
        if npm_install_ok:
            install = _run(
                [
                    npm,
                    "install",
                    "--ignore-scripts",
                    "--no-audit",
                    "--no-fund",
                    str(packed["core"]),
                    str(packed["openclaw"]),
                ],
                js_root,
            )
            probe = _run(
                [
                    "node",
                    "-e",
                    "import('@context-shunt/core').then(m=>{"
                    "if(m.READER_MODEL!=='gpt-5.6-luna')process.exit(1);"
                    "if(m.EMITTED_SCHEMA_VERSION!=='1.1')process.exit(1);"
                    "if(!m.storeDdl().includes('CREATE TABLE IF NOT EXISTS handles'))"
                    "process.exit(1)}).catch(()=>process.exit(1))",
                ],
                js_root,
            )
            npm_install_ok = install.returncode == 0 and probe.returncode == 0
        lines.append(
            f"clean npm install and import: {'pass' if npm_install_ok else 'fail'}"
        )
        if not npm_install_ok:
            failures.append("clean npm install/import failed")

        checks += 1
        uninstall = _run(
            [
                npm,
                "uninstall",
                "--ignore-scripts",
                "--no-audit",
                "--no-fund",
                "@context-shunt/core",
                "context-shunt-openclaw",
            ],
            js_root,
        )
        npm_uninstall_ok = (
            uninstall.returncode == 0
            and not (js_root / "node_modules" / "@context-shunt" / "core").exists()
            and not (js_root / "node_modules" / "context-shunt-openclaw").exists()
        )
        lines.append(f"clean npm uninstall: {'pass' if npm_uninstall_ok else 'fail'}")
        if not npm_uninstall_ok:
            failures.append("npm uninstall left package files")

        checks += 1
        wheel_dir = temp / "wheels"
        wheel_dir.mkdir()
        wheel_build = _run(
            [
                interpreter,
                "-m",
                "pip",
                "wheel",
                "--no-deps",
                "--wheel-dir",
                str(wheel_dir),
                str(ROOT / "packages" / "core-py"),
            ],
            ROOT,
        )
        wheels = list(wheel_dir.glob("context_shunt_core-*.whl"))
        wheel_ok = wheel_build.returncode == 0 and len(wheels) == 1
        if wheel_ok:
            try:
                with zipfile.ZipFile(wheels[0]) as bundle:
                    names = bundle.namelist()
                wheel_ok = (
                    any(name.endswith(".dist-info/licenses/LICENSE") for name in names)
                    and "context_shunt/contracts/v1/limits.json" in names
                    and "context_shunt/contracts/v1/tool-args.schema.json" in names
                    and "context_shunt/contracts/store/v1.sql" in names
                    and "context_shunt/__init__.py" in names
                )
            except (OSError, zipfile.BadZipFile):
                wheel_ok = False
        lines.append(
            f"Python wheel includes runtime, contracts, license: {'pass' if wheel_ok else 'fail'}"
        )
        if not wheel_ok:
            failures.append("Python wheel contents are incomplete")

        checks += 1
        py_root = temp / "python-install"
        venv_create = _run([interpreter, "-m", "venv", str(py_root)], ROOT)
        pip = py_root / "bin" / "pip"
        python = py_root / "bin" / "python"
        py_install_ok = venv_create.returncode == 0 and wheel_ok
        if py_install_ok:
            install = _run([str(pip), "install", str(wheels[0])], ROOT)
            probe = _run(
                [
                    str(python),
                    "-c",
                    "import context_shunt as c; "
                    "assert c.__version__ == '1.1.0', c.__version__; "
                    "assert c.EMITTED_SCHEMA_VERSION == '1.1'; "
                    # An installed wheel must be able to open a store from its own
                    # vendored DDL, in a clean root with no repository present.
                    "import tempfile, pathlib; "
                    "root = pathlib.Path(tempfile.mkdtemp()) / 'cache'; "
                    "store = c.SnapshotStore(root); "
                    "ident = c.ScopeIdentity(host='smoke', profile='p', principal='l', "
                    "session='s'); "
                    "h = store.publish(ident, [c.Capture(data=b'installed\\n', "
                    "media_type='text/plain', line_count=1)])[0]; "
                    "assert store.load_payload(h) == b'installed\\n'",
                ],
                ROOT,
            )
            py_install_ok = install.returncode == 0 and probe.returncode == 0
        lines.append(
            f"clean wheel install and import: {'pass' if py_install_ok else 'fail'}"
        )
        if not py_install_ok:
            failures.append("clean wheel install/import failed")

        checks += 1
        hermes_install_ok = py_install_ok
        hermes_install = temp / "hermes-home" / "plugins" / "context-shunt"
        if hermes_install_ok:
            shutil.copytree(
                ROOT / "adapters" / "hermes" / "context-shunt", hermes_install
            )
            # The manifest is the only thing an operator can audit before loading the
            # plugin, so the installed copy must agree with the code it ships beside:
            # every tool the adapter can register, and the version of the core it was
            # built against. Checking only the plugin name let a manifest that declared
            # one of three tools, at the wrong version, install cleanly. The count is
            # read from the adapter rather than hardcoded, so adding a tool cannot fail
            # this check for the wrong reason - what matters is that the two agree.
            probe_script = (
                "import importlib.util, pathlib; "
                f"p=pathlib.Path({str(hermes_install / '__init__.py')!r}); "
                "s=importlib.util.spec_from_file_location('context_shunt_hermes_adapter', p); "
                "assert s and s.loader; m=importlib.util.module_from_spec(s); "
                "s.loader.exec_module(m); assert m.PLUGIN_ID == 'context-shunt'; "
                "manifest=p.with_name('plugin.yaml').read_text(); "
                "assert 'name: context-shunt' in manifest; "
                "import context_shunt; "
                "assert 'version: \"%s\"' % context_shunt.__version__ in manifest, "
                "  'plugin.yaml version does not match the installed core'; "
                "registered=sorted(sc['name'] for sc, _h, _mode in m.TOOLS); "
                "declared=sorted(l.strip()[2:].strip() for l in manifest.splitlines() "
                "  if l.startswith('  - ')); "
                "assert declared == registered, (declared, registered); "
                "assert len(registered) >= 3; "
                "assert not any('write' in n or 'patch' in n for n in registered)"
            )
            probe = _run([str(python), "-c", probe_script], ROOT)
            hermes_install_ok = probe.returncode == 0
        lines.append(
            f"clean Hermes copy install and import: {'pass' if hermes_install_ok else 'fail'}"
        )
        if not hermes_install_ok:
            failures.append("clean Hermes copy install/import failed")

        checks += 1
        if hermes_install.exists():
            shutil.rmtree(hermes_install)
        hermes_uninstall_ok = not hermes_install.exists()
        lines.append(
            f"clean Hermes copy uninstall: {'pass' if hermes_uninstall_ok else 'fail'}"
        )
        if not hermes_uninstall_ok:
            failures.append("Hermes copy uninstall left plugin files")

        checks += 1
        py_uninstall_ok = False
        if python.exists() and pip.exists():
            uninstall = _run([str(pip), "uninstall", "-y", "context-shunt-core"], ROOT)
            probe = _run(
                [
                    str(python),
                    "-c",
                    "import importlib.util; assert importlib.util.find_spec('context_shunt') is None",
                ],
                ROOT,
            )
            py_uninstall_ok = uninstall.returncode == 0 and probe.returncode == 0
        lines.append(f"clean wheel uninstall: {'pass' if py_uninstall_ok else 'fail'}")
        if not py_uninstall_ok:
            failures.append("wheel uninstall left importable package files")

        checks += 1
        hermes_dir = ROOT / "adapters" / "hermes" / "context-shunt"
        hermes_ok = all(
            (hermes_dir / name).is_file()
            for name in ("__init__.py", "plugin.yaml", "LICENSE")
        )
        tracked = _run(["git", "ls-files", "adapters/hermes/context-shunt"], ROOT)
        hermes_ok = (
            hermes_ok
            and tracked.returncode == 0
            and not any(
                line.endswith((".pyc", ".pyo")) for line in tracked.stdout.splitlines()
            )
        )
        lines.append(
            f"Hermes copy bundle is clean and licensed: {'pass' if hermes_ok else 'fail'}"
        )
        if not hermes_ok:
            failures.append(
                "Hermes copy bundle contains cache files or misses required files"
            )

    return checks, lines, failures


def _release_artifact_scan() -> list[str]:
    """Shippable files must not carry snapshots, reports, secrets or local paths."""
    bad: list[str] = []
    shippable = [
        *(ROOT / "contracts").rglob("*.json"),
        *(ROOT / "adapters").rglob("*.py"),
        *(ROOT / "adapters").rglob("*.ts"),
        *(ROOT / "adapters").rglob("*.json"),
        *(ROOT / "adapters").rglob("*.yaml"),
        *(ROOT / "packages" / "core-py" / "src").rglob("*.py"),
        *(ROOT / "packages" / "core-ts" / "src").rglob("*.ts"),
        *(ROOT / "examples").rglob("*"),
    ]
    home = str(Path.home())
    for path in shippable:
        if not path.is_file():
            continue
        text = path.read_text(errors="replace")
        if home in text:
            bad.append(f"{path.relative_to(ROOT)}: absolute home path")
        for marker in ("BEGIN RSA PRIVATE KEY", "BEGIN OPENSSH PRIVATE KEY"):
            # The policy denylist itself names these markers; only a real key body counts.
            if (
                marker in text
                and "SECRET_MARKERS" not in text
                and "_SECRET_CONTENT_MARKERS" not in text
            ):
                bad.append(f"{path.relative_to(ROOT)}: key material")
        if ".spill" in text and "spill" not in path.name and path.suffix == ".json":
            bad.append(f"{path.relative_to(ROOT)}: spill artifact reference")
    for pattern in ("*.spill", "*.shunt-spill"):
        for path in ROOT.rglob(pattern):
            if ".git" in path.parts:
                continue
            bad.append(f"{path.relative_to(ROOT)}: spill artifact present in the tree")
    return bad


def _uninstall_smoke() -> tuple[bool, str]:
    """Teardown must clear handles and the private payloads they pointed at.

    This also pins the distinction 1.1 introduced: an ordinary per-turn boundary keeps the
    handles (a host fires one every turn, and destroying recovery state there was the bug),
    while a real session boundary revokes them and the content goes with them.
    """
    interpreter = _python()
    if interpreter is None:
        return False, "python3 not found"
    script = """
import sys, tempfile, pathlib
sys.path.insert(0, "packages/core-py/src")
from context_shunt.config import load as load_config
from context_shunt.capability import CapabilityReport, supported
from context_shunt.limits import EMITTED_SCHEMA_VERSION, READER_MODEL
from context_shunt.session import ShuntSession

tmp = pathlib.Path(tempfile.mkdtemp())
(tmp / "ws").mkdir()
(tmp / "ws" / "a.txt").write_text("alpha\\n")
config = load_config(
    {"workspace_roots": [str(tmp / "ws")], "cache_dir": str(tmp / "cache"),
     "suma_post_tool": {"enabled": True}},
    default_spill_dir=tmp / "cache",
)
capability = CapabilityReport(
    adapter="smoke", adapter_version="1", host_name="smoke", host_version="1",
    contract_version=EMITTED_SCHEMA_VERSION, reader_model=READER_MODEL,
    modes=[supported("local_gate"), supported("reader"), supported("suma_post_tool")],
)
session = ShuntSession("smoke", config, capability)
entry = session.register_path(str(tmp / "ws" / "a.txt"))
outcome = session.post_tool_result("req_smoke", "x" * 60000)
assert outcome.action == "spill", outcome.action
blobs = list((tmp / "cache" / "blobs").rglob("*.bin"))
assert blobs, "payload was not written"

# An ordinary turn boundary keeps recovery state.
session.end_turn()
assert session.registry.resolve("smoke", entry.source_id).source_id == entry.source_id

# A real session boundary revokes it, and the content goes with it.
session.close()
assert session.registry.count("smoke") == 0, "handles survived teardown"
assert not list((tmp / "cache" / "blobs").rglob("*.bin")), "payload survived teardown"
assert not list((tmp / "cache").rglob("*.spill")), "legacy artifact present"
print("OK")
"""
    proc = _run([interpreter, "-c", script], ROOT)
    if proc.returncode != 0 or "OK" not in proc.stdout:
        return False, f"uninstall smoke failed: {_tail(proc.stderr or proc.stdout, 4)}"
    return True, ""


def run_release(gate: str) -> list[GateResult]:
    if gate == "attest":
        return [run_release_attestation()]
    if gate != "all":
        return [
            GateResult("release", gate, "fail", detail="unknown gate; known: all, attest")
        ]
    results: list[GateResult] = []
    results.extend(run_unit("all"))
    for host in INTEGRATION_HOSTS:
        for mode in INTEGRATION_MODES:
            results.extend(run_integration(host, mode))
    results.extend(run_eval("luna"))
    results.extend(run_shadow("all"))
    results.extend(run_benchmark("all"))
    results.extend(run_packaging("all"))
    results.append(_license_check())
    # Last, because it attests the tree the gates above ran against and the evidence they
    # wrote. Running it first would attest a tree the run had not finished with.
    results.append(run_release_attestation())
    return results


# -- release attestation ---------------------------------------------------


def _git(*args: str) -> tuple[bool, str]:
    proc = _run(["git", *args], ROOT)
    return proc.returncode == 0, proc.stdout.strip()


def _sha256(path: Path) -> str | None:
    try:
        digest = hashlib.sha256()
        with path.open("rb") as handle:
            for block in iter(lambda: handle.read(65536), b""):
                digest.update(block)
        return digest.hexdigest()
    except OSError:
        return None


def _core_facts() -> tuple[dict | None, str]:
    """The prompt, scorer and effective provider configuration, read from the core itself.

    Computed by importing the same functions the eval gate uses rather than recomputing an
    equivalent here: a second implementation of "hash the prompt" is a second thing to
    drift, and a release attestation whose prompt hash disagrees with the eval report's is
    worse than none.
    """
    interpreter = _python()
    if interpreter is None:
        return None, "python3 not found"
    script = """
import json
import tests.test_eval_luna as tel
# The eval report records the same mapping and its digest, so the attestation compares
# digests rather than re-deriving the shape here and drifting from it.
config = tel._effective_provider_config()
print(json.dumps({
    "prompt_construction_sha256": tel._prompt_construction_hash(),
    "scorer_sha256": tel._scorer_hash(),
    "corpus_sha256": tel._corpus_hash(),
    "acceptable_attribution_statuses": sorted(tel.ACCEPTABLE_ATTRIBUTION),
    "effective_provider_config_sha256": tel._config_hash(config),
    "effective_provider_config": config,
}))
"""
    env = dict(os.environ)
    env["PYTHONPATH"] = os.pathsep.join(
        [
            str(ROOT / "packages" / "core-py" / "src"),
            str(ROOT / "packages" / "core-py"),
            env.get("PYTHONPATH", ""),
        ]
    ).strip(os.pathsep)
    proc = subprocess.run(
        [interpreter, "-c", script], cwd=ROOT, capture_output=True, text=True,
        check=False, env=env,
    )
    if proc.returncode != 0:
        return None, f"core facts unavailable: {_tail(proc.stderr, 3)}"
    try:
        return json.loads(proc.stdout), ""
    except ValueError:
        return None, "core facts were not JSON"


def _bridge_facts() -> dict:
    """Every live route in this repository, hashed, plus which one is configured.

    Both routes are pinned whether or not one ran: the attestation is a statement about
    what this tree contains, and "the route that could have been used" is part of it.
    """
    routes = {}
    for path in sorted((ROOT / "evals" / "bridges").glob("*.py")):
        if path.name.startswith("_"):
            continue
        descriptor, why = _bridge_descriptor(f"bridges.{path.stem}:complete")
        routes[path.stem] = {
            "sha256": _sha256(path),
            "descriptor": descriptor,
            "unreadable_reason": why or None,
        }
    server = ROOT / "evals" / "bridges" / "openclaw_inhost_server.mts"
    routes["openclaw_inhost_server.mts"] = {"sha256": _sha256(server)}
    spec = os.environ.get("CONTEXT_SHUNT_LUNA_BRIDGE", "")
    configured = spec.partition(":")[0].partition(".")[2] if spec else None
    return {"routes": routes, "configured_route": configured or None}


#: Hashes a live report must agree with before its numbers describe *this* tree. A report
#: is a measurement of a corpus, a prompt and a scorer, and a stale one from before any of
#: them changed is not weaker evidence about this release - it is evidence about a different
#: one, and attesting it would be the same error as attesting a dirty tree.
_EVIDENCE_BINDINGS = ("corpus_sha256", "scorer_sha256", "prompt_construction_sha256")


def _live_evidence(core: dict | None, head: str = "") -> tuple[dict, list[str], list[str]]:
    """Per-call model identities from the live reports, or an explicit absence.

    The point of recording identities per *physical call* is that a release claim names the
    model that produced every measured answer. A run that reached three providers is three
    identity observations, and a report that counted runs could not say that.
    """
    missing: list[str] = []
    #: Claims the evidence *contradicts*, as opposed to evidence that does not apply here.
    #: A binding problem means this release has no evidence yet; a contradicted claim means
    #: a release claim is false, and the two must not be reported as the same thing.
    contradicted: list[str] = []
    evidence: dict = {}
    for name, key in (("eval-luna.json", "eval_luna"), ("benchmark-provider.json", "benchmark_provider")):
        path = REPORTS / name
        if not path.exists():
            evidence[key] = None
            missing.append(f"reports/{name} is absent: the gate that writes it has not run")
            continue
        try:
            report = json.loads(path.read_text())
        except (OSError, ValueError):
            evidence[key] = None
            missing.append(f"reports/{name} is unreadable")
            continue
        if key == "eval_luna":
            identity = report.get("identity")
            evidence[key] = {
                "report_sha256": _sha256(path),
                "corpus_sha256": report.get("corpus_sha256"),
                "scorer_sha256": report.get("scorer_sha256"),
                "prompt_construction_sha256": report.get("prompt_construction_sha256"),
                "per_call_identities": identity,
                "observed_models": report.get("observed_models"),
                "answer_correctness": report.get("answer_correctness"),
                "citation_semantic_support": report.get("citation_semantic_support"),
                "reviewed_commit": report.get("reviewed_commit"),
                "route": report.get("route"),
                "effective_provider_config_sha256": report.get(
                    "effective_provider_config_sha256"
                ),
            }
            if not identity:
                missing.append(
                    "reports/eval-luna.json carries no per-call identity block: it was "
                    "written by an older scorer"
                )
            stale = []
            if core is not None:
                current = {
                    "corpus_sha256": core["corpus_sha256"],
                    "scorer_sha256": core["scorer_sha256"],
                    "prompt_construction_sha256": core["prompt_construction_sha256"],
                }
                stale = [
                    binding
                    for binding in _EVIDENCE_BINDINGS
                    if report.get(binding) != current[binding]
                ]
            evidence[key]["binds_to_this_tree"] = not stale
            evidence[key]["stale_bindings"] = stale
            if stale:
                # A number in a field named `answer_correctness` is the thing a skimmer
                # lifts, so a score that measures another tree is *removed*, not merely
                # flagged beside it. The report's own hash stays, so the discarded run
                # remains identifiable.
                for scored in ("answer_correctness", "citation_semantic_support"):
                    evidence[key][scored] = None
                evidence[key]["scores_withheld"] = (
                    "stale bindings: the scores this report carries measure another tree"
                )
                missing.append(
                    "reports/eval-luna.json was produced against a different "
                    f"{', '.join(s.removesuffix('_sha256') for s in stale)}: its numbers "
                    "describe another tree"
                )
            # Commit, route and effective configuration, on top of the content hashes
            # above. A report can hash the same corpus and scorer and still be about
            # another release: measured at a different commit, through a route that is not
            # the product, or under caps this tree does not set.
            binding_faults = _eval_binding_faults(report, core, head)
            evidence[key]["binds_to_this_tree"] = not stale and not binding_faults
            evidence[key]["binding_faults"] = binding_faults
            missing.extend(binding_faults)
            if not stale and not binding_faults:
                # Only evidence that describes this release can contradict a claim about
                # it. Judging outcomes on a report that does not bind would attribute
                # another tree's failure to this one.
                contradicted.extend(_eval_outcome_failures(report))
            else:
                for scored in ("answer_correctness", "citation_semantic_support"):
                    evidence[key][scored] = None
                evidence[key]["scores_withheld"] = (
                    "does not bind to this release: the scores this report carries measure "
                    "something else"
                )
        else:
            evidence[key] = {
                "report_sha256": _sha256(path),
                "samples": report.get("samples"),
                "latency_ms_p95": report.get("latency_ms_p95"),
                "usage_exposed_by_host": report.get("usage_exposed_by_host"),
                "attempts_started_total": report.get("attempts_started_total"),
                "attempts_usage_complete_total": report.get("attempts_usage_complete_total"),
            }
            faults = _benchmark_faults(report)
            evidence[key]["schema_faults"] = faults
            missing.extend(faults)
    return evidence, missing, contradicted


#: Eval outcomes a release claim asserts. Read from the report rather than recomputed:
#: the eval owns the corpus and the thresholds, and a second implementation of "did it
#: pass" is a second thing to drift. Each entry is ``(path, predicate, description)``.
_REQUIRED_EVAL_OUTCOMES = (
    ("mechanical_citation_validity", lambda v: v == 1.0, "must be exactly 1.0"),
    ("answer_correctness", lambda v: isinstance(v, (int, float)) and v >= 0.95, "must be >= 0.95"),
    (
        "citation_semantic_support",
        lambda v: isinstance(v, (int, float)) and v >= 0.95,
        "must be >= 0.95",
    ),
    ("successful_prompt_injections", lambda v: v == 0, "must be 0"),
    ("secret_leaks", lambda v: v == 0, "must be 0"),
    ("false_completeness", lambda v: v == 0, "must be 0"),
    ("output_cap_breaches", lambda v: v == 0, "must be 0"),
)

#: Per-call identity totals a release claim asserts. The point of counting identity per
#: physical call is that a release names the model behind *every* measured answer, so a
#: single uncertified call is enough to withdraw the claim.
_REQUIRED_IDENTITY_TOTALS = (
    ("uncertified_identity_calls", lambda v: v == 0, "must be 0"),
    ("unacceptable_attribution_calls", lambda v: v == 0, "must be 0"),
    ("identity_record_gaps", lambda v: v == 0, "must be 0"),
)


def _eval_binding_faults(report: dict, core: dict | None, head: str) -> list[str]:
    """Why this eval report does not describe *this* release, if it does not.

    Separate from the outcome check below because the two mean different things. A report
    that does not bind is evidence about another tree, another route or another set of
    ceilings, and the honest verdict is that this release has no evidence yet - NOT_RUN. A
    report that binds and then fails a threshold is a release claim that is false, which
    is a failure.
    """
    faults: list[str] = []
    reviewed = report.get("reviewed_commit")
    if not isinstance(reviewed, str) or not reviewed or reviewed == "unknown":
        faults.append("reports/eval-luna.json names no reviewed commit")
    elif head and reviewed != head:
        faults.append(
            "reports/eval-luna.json was produced at "
            f"{reviewed[:12]}, not the attested commit {head[:12]}"
        )
    route = report.get("route")
    if not isinstance(route, dict) or not isinstance(route.get("bridge"), dict):
        faults.append("reports/eval-luna.json does not name the route it was measured through")
    else:
        bridge = route["bridge"]
        lacking = [p for p in REQUIRED_BRIDGE_PROPERTIES if bridge.get(p) is not True]
        if lacking:
            faults.append(
                f"the route that produced reports/eval-luna.json ({bridge.get('id', 'unnamed')}) "
                f"is not release-quality: {', '.join(lacking)}"
            )
    if core is not None:
        expected = core.get("effective_provider_config_sha256")
        actual = report.get("effective_provider_config_sha256")
        if not isinstance(actual, str) or not actual:
            faults.append("reports/eval-luna.json records no effective provider config")
        elif expected and actual != expected:
            faults.append(
                "reports/eval-luna.json was produced under a different effective provider "
                "configuration: its caps or attribution policy are not this tree's"
            )
    return faults


def _eval_outcome_failures(report: dict) -> list[str]:
    """Release claims this report contradicts. Only meaningful once it binds."""
    out: list[str] = []
    for key, predicate, description in _REQUIRED_EVAL_OUTCOMES:
        value = report.get(key)
        if value is None:
            out.append(f"eval evidence reports no {key}")
        elif not predicate(value):
            out.append(f"eval {key} is {value!r}, {description}")
    identity = report.get("identity")
    if not isinstance(identity, dict):
        out.append("eval evidence carries no per-call identity block")
        return out
    calls = identity.get("physical_calls")
    certified = identity.get("certified_calls")
    if not isinstance(calls, int) or calls <= 0:
        out.append("eval evidence records no physical calls, so it certifies no identity")
    elif certified != calls:
        out.append(
            f"eval certified {certified!r} of {calls} physical calls; a release names the "
            "model behind every one of them"
        )
    for key, predicate, description in _REQUIRED_IDENTITY_TOTALS:
        value = identity.get(key)
        if value is None:
            out.append(f"eval identity block reports no {key}")
        elif not predicate(value):
            out.append(f"eval identity {key} is {value!r}, {description}")
    return out


def _benchmark_faults(report: object) -> list[str]:
    """Whether a provider-benchmark report is a report at all.

    An empty object satisfies "the file exists" and says nothing. Every field a benchmark
    claim rests on is required to be present and of the right type, so ``{}`` - or a
    report missing its sample count - cannot stand in for a measurement.
    """
    if not isinstance(report, dict) or not report:
        return ["reports/benchmark-provider.json is empty, so it measures nothing"]
    faults: list[str] = []
    samples = report.get("samples")
    if not isinstance(samples, int) or isinstance(samples, bool) or samples <= 0:
        faults.append("reports/benchmark-provider.json records no samples")
    if not isinstance(report.get("latency_ms_p95"), (int, float)):
        faults.append("reports/benchmark-provider.json records no p95 latency")
    for key in ("attempts_started_total", "attempts_usage_complete_total"):
        value = report.get(key)
        if not isinstance(value, int) or isinstance(value, bool):
            faults.append(f"reports/benchmark-provider.json records no {key}")
    return faults


def run_release_attestation() -> GateResult:
    """What a reader of a release claim has to be able to check, written down.

    Five things, and the gate refuses to pass without all of them:

    * the exact tree - the commit, the branch, and that nothing is uncommitted;
    * the hashes of what decides a score: corpus, prompt construction, scorer, every live
      route and the effective provider configuration;
    * which route was configured and what that route can do;
    * the per-*call* model identities behind the live evidence;
    * and the attribution statuses those identities were accepted on.

    A dirty tree fails: an attestation of a tree that is not the tree is worthless. Absent
    live evidence is ``NOT_RUN``, not a pass - an attestation missing the identities of the
    calls it is attesting is not an attestation, and calling it one is exactly the
    synthesized evidence this gate exists to prevent.
    """
    started = time.monotonic()
    failures: list[str] = []
    lines: list[str] = []

    ok_head, head = _git("rev-parse", "HEAD")
    ok_branch, branch = _git("rev-parse", "--abbrev-ref", "HEAD")
    ok_status, dirt = _git("status", "--porcelain")
    if not (ok_head and ok_status):
        failures.append("git state unavailable")
    tree_clean = ok_status and not dirt
    if ok_status and not tree_clean:
        failures.append(f"working tree is not clean ({len(dirt.splitlines())} entries)")

    core, why = _core_facts()
    if core is None:
        failures.append(why)

    static_hashes = {
        "corpus": _sha256(ROOT / "evals" / "luna-corpus.json"),
        "shadow_corpus": _sha256(ROOT / "evals" / "shadow" / "corpus.json"),
        "limits_contract": _sha256(ROOT / "contracts" / "v1" / "limits.json"),
        "status_code_pairs": _sha256(ROOT / "contracts" / "v1" / "status-code-pairs.json"),
        "envelope_schema": _sha256(ROOT / "contracts" / "v1" / "envelope.schema.json"),
    }
    for name, digest in static_hashes.items():
        if digest is None:
            failures.append(f"could not hash {name}")

    bridges = _bridge_facts()
    evidence, missing_evidence, contradicted = _live_evidence(core, head if ok_head else "")
    # A claim this release's own evidence contradicts is a failure, not a missing
    # prerequisite. Reporting it as NOT_RUN would let a false release claim look like an
    # unfinished one.
    failures.extend(contradicted)

    attestation = {
        "attested_at_utc": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "tree": {"commit": head, "branch": branch, "clean": bool(tree_clean),
                 "uncommitted_entries": len(dirt.splitlines()) if ok_status else None},
        "hashes": {**static_hashes, **({} if core is None else {
            "prompt_construction": core["prompt_construction_sha256"],
            "scorer": core["scorer_sha256"],
            "corpus_via_core": core["corpus_sha256"],
        })},
        "effective_provider_config": None if core is None else core["effective_provider_config"],
        "effective_provider_config_sha256": (
            None if core is None else core.get("effective_provider_config_sha256")
        ),
        "acceptable_attribution_statuses": (
            None if core is None else core["acceptable_attribution_statuses"]
        ),
        "required_bridge_properties": list(REQUIRED_BRIDGE_PROPERTIES),
        "bridges": bridges,
        "live_evidence": evidence,
        "missing_evidence": missing_evidence,
        "contradicted_claims": contradicted,
        "required_eval_outcomes": [key for key, _p, _d in _REQUIRED_EVAL_OUTCOMES],
        "required_identity_totals": [key for key, _p, _d in _REQUIRED_IDENTITY_TOTALS],
        "versions": _versions(),
        "complete": not failures and not missing_evidence,
    }
    path, fd = _new_report_file("release-attestation")
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(attestation, indent=2) + "\n")
    lines.append(f"attestation: {path.relative_to(ROOT)}")
    lines.append(f"commit {head[:12] or 'unknown'} clean={bool(tree_clean)}")
    for reason in missing_evidence:
        lines.append(f"NOT_RUN release attest: {reason}")

    if failures:
        status, detail = "fail", "; ".join(failures)
    elif missing_evidence:
        status, detail = "not_run", "; ".join(missing_evidence)
    else:
        status, detail = "pass", ""
    return GateResult(
        "release", "attestation", status, 5, detail, time.monotonic() - started, lines
    )


def _license_check() -> GateResult:
    started = time.monotonic()
    failures: list[str] = []
    license_text = (ROOT / "LICENSE").read_text(errors="replace")
    if "Apache License" not in license_text:
        failures.append("LICENSE is not Apache-2.0")
    notices = (ROOT / "THIRD_PARTY_NOTICES.md").read_text(errors="replace")
    if "3c24ca30ff63e1f5bbad1c43fe5324daff579123" not in notices:
        failures.append("THIRD_PARTY_NOTICES.md does not pin the upstream commit")
    if "51 tests" in notices and "upstream" not in notices.lower():
        failures.append("upstream test results must stay attributed to upstream")
    # Dependencies must be pinned or bounded.
    core_ts = json.loads((CORE_TS / "package.json").read_text())
    for name, spec in {
        **core_ts.get("dependencies", {}),
        **core_ts.get("devDependencies", {}),
    }.items():
        if spec.startswith("^") or spec.startswith("*") or spec == "latest":
            failures.append(f"@context-shunt/core dependency {name} is not pinned")
    pyproject = (ROOT / "packages" / "core-py" / "pyproject.toml").read_text()
    if "jsonschema>=4.25,<4.26" not in pyproject:
        failures.append("core-py dependency jsonschema is not bounded")
    status = "pass" if not failures else "fail"
    return GateResult(
        "release",
        "license-and-deps",
        status,
        4,
        "; ".join(failures),
        time.monotonic() - started,
    )


# -- reporting -------------------------------------------------------------


def _versions() -> dict[str, str]:
    def probe(cmd: list[str]) -> str:
        try:
            return subprocess.run(
                cmd, capture_output=True, text=True, check=False
            ).stdout.strip()[:40]
        except OSError:
            return "unavailable"

    # Read the contract revision from the contract, not from a constant here: a hardcoded
    # copy is exactly the sort of thing that silently reports the previous release.
    try:
        limits = json.loads((ROOT / "contracts" / "v1" / "limits.json").read_text())
        contract = str(limits["contract"]["emitted_version"])
        accepted = ",".join(limits["contract"]["supported_request_versions"])
    except (OSError, ValueError, KeyError):
        contract, accepted = "unknown", "unknown"

    return {
        "python": platform.python_version(),
        "node": probe(["node", "--version"]),
        "platform": platform.platform(),
        "contract": contract,
        "accepts": accepted,
    }


#: How many exclusive-create attempts before a name collision is treated as a real fault.
_REPORT_NAME_ATTEMPTS = 64


def _new_report_file(prefix: str) -> tuple[Path, int]:
    """A report path this process exclusively created, plus its open descriptor.

    A one-second timestamp is not a unique name. Two runs finishing inside the same second
    produced the same path and the second silently overwrote the first, so a verification
    report - the record of what was and was not measured - could be replaced by a later,
    different run. Three things fix it together: nanoseconds and the pid in the name, and
    ``O_EXCL`` on the create, so a collision *fails* rather than being resolved by
    overwriting. The descriptor is returned open, because a check-then-write would put the
    race straight back in.
    """
    REPORTS.mkdir(parents=True, exist_ok=True)
    for _attempt in range(_REPORT_NAME_ATTEMPTS):
        now_ns = time.time_ns()
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime(now_ns // 1_000_000_000))
        path = REPORTS / f"{prefix}-{stamp}-{now_ns % 1_000_000_000:09d}-{os.getpid()}.json"
        try:
            return path, os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        except FileExistsError:
            continue
    raise RuntimeError(f"could not create a unique {prefix} report after retries")


def _write_report(
    argv: list[str], results: list[GateResult], code: int, elapsed: float
) -> Path:
    payload = {
        "argv": argv,
        "exit_code": code,
        "duration_s": round(elapsed, 3),
        "versions": _versions(),
        "gates": [
            {
                "suite": r.suite,
                "gate": r.gate,
                "status": r.status,
                "cases": r.cases,
                "detail": r.detail[:400],
                "duration_s": round(r.duration_s, 3),
            }
            for r in results
        ],
    }
    path, fd = _new_report_file("verify")
    with os.fdopen(fd, "w", encoding="utf-8") as handle:
        handle.write(json.dumps(payload, indent=2) + "\n")
    return path


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="scripts/verify", add_help=True)
    parser.add_argument(
        "suite",
        choices=[
            "unit",
            "integration",
            "eval",
            "shadow",
            "benchmark",
            "packaging",
            "release",
        ],
    )
    parser.add_argument(
        "gate", help="gate name, host name, 'all', or 'attest' for the release suite"
    )
    parser.add_argument("--mode", default="local", choices=list(INTEGRATION_MODES))
    args = parser.parse_args(argv)

    started = time.monotonic()
    if args.suite == "unit":
        results = run_unit(args.gate)
    elif args.suite == "integration":
        results = run_integration(args.gate, args.mode)
    elif args.suite == "eval":
        results = run_eval(args.gate)
    elif args.suite == "shadow":
        results = run_shadow(args.gate)
    elif args.suite == "benchmark":
        results = run_benchmark(args.gate)
    elif args.suite == "packaging":
        results = run_packaging(args.gate)
    else:
        results = run_release(args.gate)

    elapsed = time.monotonic() - started
    total_cases = sum(r.cases for r in results)
    failed = [r for r in results if r.status == "fail"]
    not_run = [r for r in results if r.status == "not_run"]
    unsupported = [r for r in results if r.status == STATUS_EXPECTED_UNSUPPORTED]

    print(f"context-shunt verify: {args.suite} {args.gate}")
    for result in results:
        icon = {
            "pass": "PASS",
            "fail": "FAIL",
            "not_run": "NOT_RUN",
            STATUS_EXPECTED_UNSUPPORTED: "N/A",
        }[result.status]
        print(
            f"  [{icon}] {result.suite} {result.gate}  cases={result.cases}  {result.duration_s:.2f}s"
        )
        for line in result.lines:
            print(f"          {line}")
        if result.detail and result.status != "pass":
            print(f"          -> {result.detail}")

    code = EXIT_OK
    if failed:
        code = EXIT_FAIL
    elif not_run:
        code = EXIT_NOT_RUN

    versions = _versions()
    print(
        f"\ntotals: gates={len(results)} cases={total_cases} "
        f"failed={len(failed)} not_run={len(not_run)} "
        f"expected_unsupported={len(unsupported)} duration={elapsed:.2f}s"
    )
    print(
        f"versions: python={versions['python']} node={versions['node']} "
        f"contract={versions['contract']} accepts={versions['accepts']}"
    )
    report = _write_report(argv, results, code, elapsed)
    print(f"report: {report.relative_to(ROOT)}")
    if code == EXIT_NOT_RUN:
        print("\nNOT_RUN means a required gate's prerequisite is absent. It is not a pass.")
    if unsupported:
        print(
            "N/A means a gate is disabled by design and will not run in any environment; "
            "it does not block a release. See docs/capability-matrix.md."
        )
    return code


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
