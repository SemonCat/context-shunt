{
  "schema_version": "1.0",
  "description": "Citation verification contract. quote must be an exact substring of the addressed line (text) or of the canonical JSON of the addressed record (JSON). verified is written by the verifier only; a rejected citation is never published.",
  "reasons": [
    "OK",
    "LINE_OUT_OF_RANGE",
    "QUOTE_NOT_FOUND",
    "POINTER_NOT_FOUND",
    "RECORD_OUT_OF_RANGE",
    "SNAPSHOT_MISMATCH",
    "HANDLE_UNKNOWN",
    "HANDLE_EXPIRED",
    "QUOTE_OVER_CAP",
    "LOCATOR_UNSUPPORTED"
  ],
  "sources": {
    "text_lf": {
      "media_type": "text/plain",
      "content": "import os\nmax_retries = 3\nbackoff = \"exponential\"\nline4\nline5\nline6\nline7\nline8\nline9\nline10\nline11\ntail_no_newline"
    },
    "text_crlf": {
      "media_type": "text/plain",
      "content": "alpha\r\nbeta = 7\r\ngamma\r\n"
    },
    "text_longline": {
      "media_type": "text/plain",
      "content": "prefix AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA needle BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB suffix\nsecond line\n"
    },
    "json_doc": {
      "media_type": "application/json",
      "content": "{\"count\":2,\"items\":[{\"name\":\"alpha\",\"retries\":1},{\"name\":\"beta\",\"retries\":3}],\"meta\":{\"version\":\"2\"}}"
    },
    "json_scalar": {
      "media_type": "application/json",
      "content": "\"just-a-string\""
    }
  },
  "cases": [
    {
      "id": "line_exact_quote",
      "source": "text_lf",
      "locator": {
        "kind": "lines",
        "start": 2,
        "end": 2
      },
      "quote": "max_retries = 3",
      "expect": {
        "verified": true,
        "reason": "OK"
      }
    },
    {
