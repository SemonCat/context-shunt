            "c1",
            "c2"
          ]
        }
      ],
      "expect": {
        "surviving_claims": [
          {
            "text": "The timeout backs off exponentially before that ceiling.",
            "citation_ids": [
              "c1",
              "c2"
            ]
          }
        ],
        "rendered": "The timeout backs off exponentially before that ceiling [c1][c2]."
      }
    },
