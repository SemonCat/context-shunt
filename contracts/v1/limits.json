{
  "schema_version": "1.1",
  "description": "Normative caps from docs/architecture.md. Both cores load this file; no core may hardcode a different value. Deployments may only lower these. Revision 1.1 adds the contract/inspect/disclosure/store/accounting/artifact_import blocks and leaves every 1.0 value unchanged.",
  "reader_model": "gpt-5.6-luna",
  "contract": {
    "emitted_version": "1.1",
    "supported_request_versions": ["1.0", "1.1"]
  },
  "gate": {
    "full_read_max_lines": 350,
    "targeted_read_max_lines": 350,
    "targeted_search_max_matches": 200,
    "probe_max_lines_scanned": 351,
    "probe_timeout_ms": 1000
  },
  "bytes": {
    "max_tool_result_bytes": 16384,
    "max_envelope_bytes": 16384,
    "max_extended_envelope_bytes": 20480,
    "max_targeted_read_bytes": 16384,
    "max_extraction_bytes": 16384,
    "max_source_bytes": 8388608,
    "max_chunk_bytes": 32768,
    "max_answer_bytes": 8192,
    "max_quote_bytes": 512,
    "max_question_bytes": 2048,
    "session_spill_quota_bytes": 67108864
  },
  "counts": {
    "max_sources_per_request": 8,
    "min_sources_per_request": 1,
    "max_chunks_per_request": 8,
    "max_citations": 16,
    "max_concurrent_model_calls": 2,
    "max_chunk_overlap_lines": 1,
    "max_transient_retries": 1
  },
  "tokens": {
    "max_chunk_tokens": 8000,
    "max_request_input_tokens": 64000,
    "max_output_tokens_per_call": 2048,
    "bytes_per_token_estimate": 4
  },
  "deadlines_ms": {
    "gate_probe": 1000,
    "spill_io": 5000,
    "model_call": 45000,
    "request": 60000
  },
  "spill": {
    "ttl_seconds": 3600,
    "dir_mode": "0700",
    "file_mode": "0600"
  },
  "json": {
    "max_depth": 64,
    "max_nodes": 100000
  },
  "inspect": {
    "max_result_bytes": 16384,
    "max_segments": 64,
    "max_lines_per_page": 400,
    "max_bytes_per_page": 16384,
    "max_scan_lines": 20000,
    "max_scan_bytes": 8388608,
    "max_search_matches": 200,
    "max_needle_bytes": 512
  },
  "artifact_import": {
    "max_manifest_bytes": 65536,
    "max_import_roots": 8
  },
  "disclosure": {
    "max_per_source_bytes": 262144,
    "max_per_session_bytes": 1048576
  },
  "store": {
    "ddl": "contracts/store/v1.sql",
    "ddl_version": 2,
    "busy_timeout_ms": 5000,
    "max_entries": 512,
    "max_bytes": 268435456,
    "handle_ttl_seconds": 3600
  },
  "accounting": {
    "baseline_method": "bytes_div_4",
    "max_stats_records_per_page": 8,
    "max_stats_pages": 64
  }
}
